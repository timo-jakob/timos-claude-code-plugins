# yamllint config for this repo. Extends the default ruleset with relaxations
# that fit GitHub Actions workflows and our other YAML (see #260 / #263).
---
extends: default

# Also lint the bootstrap workflow/config TEMPLATES (*.yml.tmpl / *.yaml.tmpl).
# They become a new repo's files, so they must pass the same rules — otherwise a
# freshly-bootstrapped repo fails its very first YAML check. Their {{PLACEHOLDER}}
# tokens sit in valid YAML positions, so they lint as-is.
yaml-files:
  - '*.yaml'
  - '*.yml'
  - '.yamllint'
  - '*.yaml.tmpl'
  - '*.yml.tmpl'

rules:
  # Workflows have long `run:` lines and URLs; 80 is too tight.
  line-length:
    max: 120
    level: warning
  # GitHub Actions' `on:` key is valid; don't flag it as a "truthy" value.
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
  # Workflow / config files conventionally omit the `---` document start.
  document-start: disable
