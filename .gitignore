# macOS
.DS_Store

# Claude Code
.claude/

# Python bytecode cache (the maintenance scripts include parse-*.py helpers)
__pycache__/
*.pyc

# Editors
*.swp
*.swo
*~
.vscode/
.idea/

# Snyk Security Extension - AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md

# MkDocs build output (docs site, #753)
site/

# pandoc docs manuals (built in CI, #754)
/manual.pdf
/manual.epub
/chapters.txt
# pandoc's own stderr, kept so the gate can fail on a dropped character
/pandoc-pdf.log

# resolve-issue review loop dispatch sink (local, per-run state; telemetry
