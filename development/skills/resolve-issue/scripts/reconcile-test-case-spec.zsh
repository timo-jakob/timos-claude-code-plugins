#!/usr/bin/env zsh
# reconcile-test-case-spec.zsh — write a build-disproved test-case expectation
# into the story's story-spec/v1 block and re-render the linked test-case
# bodies from it (#3089).
#
# resolve-issue §6 (reference/checkpoint.md § Reconciling the test-case bodies
# before the PR) runs this when a build's acceptance test contradicts a
# test-case expectation. The story's story-spec/v1 block is the single source of
# truth for that expectation: a test-case body is generated by
# refine-issue's test-case-spinout.zsh and marked "do not hand-edit", so the
# reconcile changes the block and lets the spin-out re-render the body. A later
# spin-out re-run then renders the reconciled expectation, never the old one.
#
# For each id in the map whose entry's `shape` differs from the shipped one, it:
#   - sets `test_cases[<id>].shape` to the shipped expectation;
#   - removes `provisional` from that entry;
#   - sets `reconciled` to the map's one-line note
#     (`Reconciled before close: the build found <shipped behaviour>, not
#     <the old expectation> (story #<N>).`).
# An entry whose `shape` already equals the shipped one is left alone, so a
# re-run writes nothing.
#
# Then, in this order, so a re-run after any failure redoes exactly the work
# still missing:
#   1. runs test-case-spinout.zsh --spec <new block> --old-spec <old block>,
#      which re-renders each linked body (an edit is idempotent);
#   2. replaces ONLY the fenced story-spec json inside the story body and
#      writes it with `gh issue edit --body-file`. Every byte outside that fence
#      — the sentinel-wrapped prose region included — is kept, and `provenance`
#      is carried over unchanged, so `prose_sha256` still verifies.
# The block written carries the spin-out's reconciled test_cases (issue links).
#
# Usage:
#   reconcile-test-case-spec.zsh --repo <owner/name> --story <N> --map <map.json>
#
#   --map: a JSON object {"<test-case id>": {"shape": "<shipped expectation>",
#          "note": "<the one-line Reconciled before close: note>"}, …}
#
# stdout: one JSON object {"updated": [{id, issue, shape}], "unchanged": [id]}.
#
# Exit codes: 0 ok (written, or nothing to write) · 1 runtime error (gh, jq or
#             the spin-out failed, the story has no story-spec/v1 block, or a
#             map id is not in it); nothing is written past the failing step,
#             and a re-run is safe · 2 usage error (bad args or a malformed map).

emulate -L zsh
set -euo pipefail

local -r self_dir="${0:A:h}"
local -r plugin_root="${self_dir:h:h:h}"
local -r spinout="$plugin_root/skills/refine-issue/scripts/test-case-spinout.zsh"
local -r reader="$self_dir/read-story-spec.zsh"

_usage() { print -u2 -r -- "reconcile-test-case-spec.zsh: $*"; exit 2; }
_fail()  { print -u2 -r -- "reconcile-test-case-spec.zsh: $*"; exit 1; }

local repo="" story="" map=""
while (( $# > 0 )); do
  case "$1" in
    --repo|--story|--map)
      (( $# >= 2 )) || _usage "$1 needs a value"
      case "$1" in
        --repo)  repo="$2" ;;
        --story) story="$2" ;;
        --map)   map="$2" ;;
      esac
      shift 2 ;;
    -h|--help) sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) _usage "unknown arg: $1" ;;
  esac
done

[[ -n "$repo" ]]  || _usage "--repo is required"
[[ -n "$story" ]] || _usage "--story is required"
[[ -n "$map" ]]   || _usage "--map is required"
[[ "$story" == <-> ]] || _usage "--story must be a number, got: $story"
command -v jq >/dev/null 2>&1 || _fail "jq not found on PATH"
[[ -f "$map" ]] || _usage "map file not found: $map"
jq -e 'type == "object" and length > 0 and all(.[];
         type == "object"
         and (.shape | type == "string" and test("\\S"))
         and (.note | type == "string" and test("^Reconciled before close: ") and (test("\n") | not)))' \
  "$map" >/dev/null 2>&1 \
  || _usage "--map must be a non-empty object of {id: {shape, note}}, each note one 'Reconciled before close: ' line"

local tmp; tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The story body, byte-exact (no added trailing newline).
gh issue view "$story" --repo "$repo" --json body > "$tmp/view.json" \
  || _fail "could not read story #$story"
jq -j '.body' "$tmp/view.json" > "$tmp/body.md" || _fail "could not read story #$story's body"

"$reader" --file "$tmp/body.md" > "$tmp/old.json" \
  || _fail "story #$story carries no readable story-spec/v1 block"

local missing
missing="$(jq -r --slurpfile m "$map" \
  '[($m[0] | keys[]) as $id | select([(.test_cases // [])[] | .id] | index($id) | not) | $id] | join(", ")' \
  "$tmp/old.json")"
[[ -z "$missing" ]] || _fail "story #$story's story-spec has no test case with id: $missing"

# The new block: only entries whose shape differs from the shipped one change.
jq --slurpfile m "$map" '
  .test_cases |= map(
    if ($m[0][.id] != null) and (.shape != $m[0][.id].shape)
    then (.shape = $m[0][.id].shape | del(.provisional) | .reconciled = $m[0][.id].note)
    else . end)' "$tmp/old.json" > "$tmp/new.json" || _fail "could not build the reconciled block"

local updated_ids
updated_ids="$(jq -c --slurpfile m "$map" \
  '[(.test_cases // [])[] | select(($m[0][.id] != null) and (.shape != $m[0][.id].shape)) | .id]' \
  "$tmp/old.json")"

if [[ "$updated_ids" == "[]" ]]; then
  jq -cn --slurpfile m "$map" '{updated: [], unchanged: ($m[0] | keys)}'
  exit 0
fi

# 1. Re-render the linked bodies from the new block.
"$spinout" --repo "$repo" --story "$story" --spec "$tmp/new.json" --old-spec "$tmp/old.json" \
  > "$tmp/linked.json" || _fail "test-case-spinout.zsh failed; the story's block was not written"
jq -e 'type == "array"' "$tmp/linked.json" >/dev/null 2>&1 \
  || _fail "test-case-spinout.zsh printed no test_cases array; the story's block was not written"
jq --slurpfile l "$tmp/linked.json" '.test_cases = $l[0]' "$tmp/new.json" > "$tmp/final.json" \
  || _fail "could not merge the spin-out's links"

# 2. Splice the new block into the body: locate the LAST top-level ```json fence
# whose content is story-spec/v1 (the block read-story-spec.zsh selected) and
# replace only the lines between its opening and closing fence.
awk -v dir="$tmp" '
  {
    stripped = $0; sub(/^[[:space:]]*/, "", stripped)
    nb = 0; while (substr(stripped, nb + 1, 1) == "`") nb++
    isfence = (nb >= 3)
    rest = substr(stripped, nb + 1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", rest)
    if (!incode) {
      if (isfence) {
        lang = rest; sub(/[[:space:]].*$/, "", lang); lang = tolower(lang)
        incode = 1; fencelen = nb; capjson = (lang == "json")
        if (capjson) { n++; open = NR; fn = sprintf("%s/block-%03d.json", dir, n); printf "" > fn }
      }
      next
    }
    if (isfence && nb >= fencelen && rest == "") {
      if (capjson) printf "%s\t%d\t%d\n", fn, open, NR > (dir "/ranges.tsv")
      incode = 0; capjson = 0; next
    }
    if (capjson) print $0 > fn
  }
' "$tmp/body.md"

local f start end hit_start="" hit_end=""
[[ -f "$tmp/ranges.tsv" ]] || _fail "story #$story's body has no closed json fence"
while IFS=$'\t' read -r f start end; do
  if jq -e -s '(.[0].schema // "") == "story-spec/v1"' "$f" >/dev/null 2>&1; then
    hit_start="$start"; hit_end="$end"
  fi
done < "$tmp/ranges.tsv"
[[ -n "$hit_start" ]] || _fail "could not locate the story-spec/v1 fence in story #$story's body"

{
  head -n "$hit_start" "$tmp/body.md"
  jq . "$tmp/final.json"
  tail -n "+$hit_end" "$tmp/body.md"
} > "$tmp/new-body.md"

# The written block must read back as the reconciled one.
"$reader" --file "$tmp/new-body.md" > "$tmp/check.json" \
  && jq -e -s '.[0] == .[1]' "$tmp/check.json" "$tmp/final.json" >/dev/null \
  || _fail "the spliced body does not read back as the reconciled block; nothing was written"

gh issue edit "$story" --repo "$repo" --body-file "$tmp/new-body.md" >/dev/null \
  || _fail "could not write story #$story's body"

jq -cn --slurpfile f "$tmp/final.json" --slurpfile m "$map" --argjson u "$updated_ids" '
  { updated: [ $f[0].test_cases[] | select(.id as $i | $u | index($i)) | {id, issue, shape} ],
    unchanged: [ ($m[0] | keys[]) as $id | select($u | index($id) | not) | $id ] }'
