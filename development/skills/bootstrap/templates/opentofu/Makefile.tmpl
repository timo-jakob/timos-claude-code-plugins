# This repository's gate, bootstrapped by /development:bootstrap.
#
#   make lint    the gate COMMAND — CI (.github/workflows/opentofu-ci.yml) and hooks/pre-push run exactly this
#   make hooks   point git at the version-controlled hooks/ directory; run it once per clone
#
# `lint` runs the gate MECHANISM, scripts/tofu-gate.zsh, through zsh rather than by its executable bit, so a
# checkout that lost the mode still gates.
.PHONY: lint hooks

lint:
	zsh scripts/tofu-gate.zsh

hooks:
	git config core.hooksPath hooks
