# OpenSSF Scorecard — supply-chain security health check.
# Runs ~20 automated checks (branch protection, signed releases, dangerous
# workflow patterns, pinned dependencies, code-review coverage, etc.) and
# publishes the score to scorecard.dev plus a SARIF report visible in the
# repo's Security tab.
#
# Public repos only — Scorecard publishes a public score tied to the repo
# URL and isn't designed for private repos.

name: OpenSSF Scorecard

on:
  branch_protection_rule:     # re-score when protection rules change
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
  schedule:
    - cron: "30 6 * * 1"      # weekly Monday 06:30 UTC (offset from other scans)
  workflow_dispatch:

permissions: read-all

jobs:
  analysis:
    name: Scorecard analysis
    runs-on: ubuntu-latest
    permissions:
      security-events: write   # upload SARIF to code scanning
      id-token: write          # publish results via OIDC to scorecard.dev
      contents: read           # read repo content
      actions: read            # read workflow definitions
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Run Scorecard
        uses: ossf/scorecard-action@fa7117db83c52d787ae5a89f350999701505d78e # v2.5.0
        with:
          results_file: results.sarif
          results_format: sarif
          # Publish to https://scorecard.dev — makes the badge URL work.
          publish_results: true

      - name: Upload SARIF artifact (for download from this workflow run)
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: scorecard-sarif
          path: results.sarif
          retention-days: 30

      - name: Upload SARIF to GitHub code scanning
        uses: github/codeql-action/upload-sarif@24c54180a607b1449ed407dd24f251e4e9147c8d # v4.38.3
        with:
          sarif_file: results.sarif
          category: scorecard
