name: kubernetes-ci
# ONE job, ONE command. The gate MECHANISM is scripts/k8s-gate.zsh (render -> schema -> lint -> policy ->
# config-scan -> argocd, one `gate: <stage> ...` verdict line each). The gate COMMAND that runs it is recorded in
# .maintenance.yml as `gate:`, and this workflow runs that same command and nothing else — the same one
# hooks/pre-push runs. A check that fails here is the check that fails on a developer's machine: nothing may
# run in CI that the local gate does not.
on:
  pull_request:
permissions:
  contents: read
jobs:
  gate:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      # the gate script is `#!/usr/bin/env zsh`, and ubuntu-latest ships no zsh
      - name: install zsh
        run: |
          set -euo pipefail
          sudo apt-get update -q
          sudo apt-get install -y --no-install-recommends zsh
      # Every tool the gate runs is installed below at a PINNED version, into one directory put first on PATH —
      # helm and kustomize included, although ubuntu-latest ships both: the runner image's versions move on
      # GitHub's schedule, and a verdict must not. Each pin is a STEP-level env on a uniquely named
      # `install <tool>` step; the bootstrap plugin's fixture harness reads its pins from exactly that shape, so a
      # verdict counted there is the verdict this job reaches.
      - name: put the tool directory on PATH
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/gate-bin"
          echo "$RUNNER_TEMP/gate-bin" >> "$GITHUB_PATH"
      - name: install helm
        run: |
          set -euo pipefail
          curl -sSfL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
            | tar -xz -C "$RUNNER_TEMP/gate-bin" --strip-components=1 linux-amd64/helm
        env:
          HELM_VERSION: 3.21.3
      - name: install kustomize
        run: |
          set -euo pipefail
          url="https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}"
          curl -sSfL "$url/kustomize_v${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" \
            | tar -xz -C "$RUNNER_TEMP/gate-bin" kustomize
        env:
          KUSTOMIZE_VERSION: 5.8.1
      - name: install kubeconform
        run: |
          set -euo pipefail
          url="https://github.com/yannh/kubeconform/releases/download"
          curl -sSfL "$url/v${KUBECONFORM_VERSION}/kubeconform-linux-amd64.tar.gz" \
            | tar -xz -C "$RUNNER_TEMP/gate-bin" kubeconform
        env:
          KUBECONFORM_VERSION: 0.6.7
      - name: install kube-linter
        run: |
          set -euo pipefail
          url="https://github.com/stackrox/kube-linter/releases/download"
          curl -sSfL "$url/v${KUBE_LINTER_VERSION}/kube-linter-linux.tar.gz" \
            | tar -xz -C "$RUNNER_TEMP/gate-bin" kube-linter
        env:
          KUBE_LINTER_VERSION: 0.7.2
      - name: install kyverno
        run: |
          set -euo pipefail
          url="https://github.com/kyverno/kyverno/releases/download/v${KYVERNO_VERSION}"
          curl -sSfL "$url/kyverno-cli_v${KYVERNO_VERSION}_linux_x86_64.tar.gz" \
            | tar -xz -C "$RUNNER_TEMP/gate-bin" kyverno
        env:
          KYVERNO_VERSION: 1.13.4
      - name: install trivy
        run: |
          set -euo pipefail
          url="https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}"
          curl -sSfL "$url/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
            | tar -xz -C "$RUNNER_TEMP/gate-bin" trivy
        env:
          TRIVY_VERSION: 0.70.0
      # mikefarah's yq, which the argocd stage's `-o=json` needs — never Debian's python-yq
      - name: install yq
        run: |
          set -euo pipefail
          curl -sSfLo "$RUNNER_TEMP/gate-bin/yq" \
            "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_amd64"
          chmod +x "$RUNNER_TEMP/gate-bin/yq"
        env:
          YQ_VERSION: 4.44.3
      # The gate command, substituted at bootstrap time from .maintenance.yml's `gate:`. Keep it the LAST step.
      - name: run the gate
        run: |
          {{GATE_COMMAND}}
