# SonarQube (self-hosted) project configuration.
# Note: no `sonar.organization` — that's a SonarCloud-only field.

sonar.projectKey={{PROJECT_KEY}}
sonar.projectName={{PROJECT_NAME}}

sonar.sources=.
sonar.exclusions=**/node_modules/**,**/vendor/**,**/dist/**,**/.build/**,**/build/**,**/coverage/**,**/*.generated.*
sonar.tests=.
sonar.test.inclusions=**/*.test.*,**/*_test.*,**/test_*.*,**/tests/**,**/__tests__/**,**/*Tests.swift,**/src/test/**

# --- TYPESCRIPT-START ---
sonar.javascript.lcov.reportPaths=coverage/lcov.info
# --- TYPESCRIPT-END -----
# --- PYTHON-START -------
sonar.python.coverage.reportPaths=coverage.xml
# Without this, Sonar warns "Your code is analyzed as compatible with all
# Python 3 versions by default. You can get a more precise analysis by
# setting the exact Python version..." — set it to the project's actual
# runtime (derived from pyproject.toml's `requires-python` by the
# bootstrap script).
sonar.python.version={{PYTHON_VERSION}}
# --- PYTHON-END ---------
# --- GO-START -----------
sonar.go.coverage.reportPaths=coverage.out
# --- GO-END -------------
# --- SWIFT-START --------
sonar.swift.coverage.reportPaths=coverage.lcov
# --- SWIFT-END ----------
# --- JAVA-START ---------
sonar.coverage.jacoco.xmlReportPaths=build/reports/jacoco/test/jacocoTestReport.xml
# Sonar's Java analyzer needs compiled bytecode to resolve types; point it at
# the Gradle output (`gradle build` produces these in CI before the scan).
sonar.java.binaries=build/classes
# Keep generated sources (protobuf/gRPC stubs, annotation processors) out of
# coverage + analysis so they don't skew the gate.
sonar.coverage.exclusions=**/build/generated/**
sonar.exclusions=**/build/generated/**
sonar.java.test.binaries=build/classes
# --- JAVA-END -----------

sonar.scm.provider=git

# Quality gate assignment happens via API (see SETUP.md), not here.
