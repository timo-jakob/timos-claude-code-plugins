# Quality + security pipeline for PRIVATE repositories.
# Composed from the repo's resolved quality toolchain (.maintenance.yml's
# `tools:`, #1651/#1670). The static analyser picks the runner: SonarQube CE
# runs every job on a self-hosted runner that can reach the local SonarQube
# instance; SonarCloud runs every job on GitHub-hosted runners. The
# vulnerability scanner is Trivy (filesystem deps + container image) or Snyk
# (its GitHub App out of CI, plus the `image` job's container scan).
#
# Image publishing: built image is scanned (`image` job), then pushed to
# GitHub Container Registry (ghcr.io/<owner>/<repo>) on merge to main +
# release events by the separate `push-and-sign` job (`needs: image`). The
# scan gates the push — a vulnerable image never reaches the registry — and
# only the push job holds write-capable permissions (#547).

name: Quality (private)

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths-ignore:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths-ignore:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"
  release:
    types: [published]
  schedule:
    # Weekly Monday 06:00 UTC — drift detection against newly-disclosed CVEs
    # and updated license categorizations.
    - cron: "0 6 * * 1"
  workflow_dispatch:

# Least-privilege workflow defaults. Individual jobs may widen as needed:
# only the `push-and-sign` job (push/release events, never PRs) needs
# `packages: write` + `id-token: write` for GHCR push and cosign keyless
# signing; nothing else needs anything beyond `contents: read`. Job
# permissions can't be gated per-step, so the write grants live in a job
# that PR runs never execute (#547).
permissions:
  contents: read

concurrency:
  group: quality-${{ github.ref }}
  cancel-in-progress: true

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  # --- NOT_SOLE_GO-START -------------------------------------------------------
  # Swift has its own macOS job below (the SWIFT block), not a step section
  # here — xcodebuild/xcrun don't exist on Linux runners.
  # --- LINUX_TESTS-START -------------------------------------------------------
  test-and-coverage:
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Full history: diff-cover needs a merge base with origin/<base>,
          # and a shallow PR checkout has none (its parent link is cut).
          fetch-depth: 0

      # --- JAVASCRIPT-START ------------------------------------------------
      - name: Setup Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "24"
          cache: "npm"
      - name: Install (npm ci)
        run: npm ci
      - name: Lint (ESLint)
        run: npx eslint .
      - name: Format check (Prettier)
        run: npx prettier --check .
      - name: Test + coverage (vitest)
        run: npx vitest run --coverage
      # --- JAVASCRIPT-END --------------------------------------------------

      # --- PYTHON-START ----------------------------------------------------
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
        with:
          python-version: "{{PYTHON_VERSION}}"
          cache: "pip"
      - run: |
          [[ -f requirements.txt ]] && pip install -r requirements.txt
          pip install -e ".[dev]"
          pip install pytest-cov
          # Pass --cov=<source-dir> explicitly so coverage.py tracks every
          # file under it, including modules no test imports — otherwise
          # diff-cover reports "No lines with coverage information" on
          # never-imported new modules and looks like a tool failure
          # rather than a coverage shortfall. See issue #101.
          if [[ -d src ]]; then COV_SRC="src"; else COV_SRC="."; fi
          pytest --cov="$COV_SRC" --cov-report=xml --cov-report=term

      # Coverage floor — belt-and-suspenders for the 90% bar. Custom
      # Quality Gates work on self-hosted SonarQube CE so the Sonar gate
      # would catch this too, but the CI step gives faster feedback (PR
      # status check fails immediately, not after the Sonar scan completes)
      # and stays consistent with the public-path template.
      - name: Install diff-cover (Python — coverage floor)
        if: github.event_name == 'pull_request'
        run: pip install 'diff-cover>=9'
      # BASE_REF is funnelled through `env:` rather than inlined into
      # `run:` to keep semgrep's run-shell-injection rule happy —
      # github-context values are untrusted input. Applies to the coverage
      # step below.
      - name: Coverage floor — 90% on new code (Python)
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          diff-cover coverage.xml \
            --compare-branch="origin/${BASE_REF}" \
            --fail-under=90 \
            --show-uncovered
      # --- PYTHON-END ------------------------------------------------------

      # --- GO-START --------------------------------------------------------
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7
        with:
          go-version: "stable"
      # -race + per-package coverage (no -coverpkg), matching the #874 gate.
      - run: go test -race ./... -coverprofile=coverage.out -covermode=atomic
      # Cobertura conversion so the shared diff-cover new-code gate reads it —
      # the go.mod-pinned tool `make test` uses, and the diff-cover pin
      # `make setup` installs for the gate (#2620). A go.mod without the tool
      # directive fails here with the fix, not go's bare "no such tool" (#2864).
      - if: github.event_name == 'pull_request'
        run: |
          go tool -n gocover-cobertura >/dev/null || {
            echo "::error::go tool gocover-cobertura failed (go's error above) — if go.mod has no tool directive," \
              "run: go get -tool github.com/boumenot/gocover-cobertura@latest"
            exit 1
          }
          go tool gocover-cobertura -ignore-gen-files < coverage.out > coverage.xml
      - if: github.event_name == 'pull_request'
        run: pip install 'diff-cover==10.2.0'
      - if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          diff-cover coverage.xml \
            --compare-branch="origin/${BASE_REF}" \
            --fail-under=90 \
            --show-uncovered
      # --- GO-END ----------------------------------------------------------

      # --- JAVA-START ------------------------------------------------------
      - name: Setup JDK
        uses: actions/setup-java@de7274f081f381c8f8158605e0321c36c376e2e6 # v6.0.1
        with:
          distribution: "temurin"
          java-version: "{{JAVA_VERSION}}"
      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@3f5f9adaf7d9fecd50b5935e54106014257a94e6 # v6.4.0
      - name: Build + test + coverage (Java)
        run: ./gradlew --no-daemon build jacocoTestReport
      - name: Install diff-cover (Java — coverage floor)
        if: github.event_name == 'pull_request'
        run: pipx install 'diff-cover>=9'
      - name: Coverage floor — 90% on new code (Java)
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          diff-cover build/reports/jacoco/test/jacocoTestReport.xml \
            --compare-branch="origin/${BASE_REF}" \
            --fail-under=90 \
            --show-uncovered
      # --- JAVA-END --------------------------------------------------------

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: coverage-reports
          path: |
            coverage.xml
            coverage.out
            coverage.lcov
            coverage/lcov.info
            build/reports/jacoco/test/jacocoTestReport.xml
          if-no-files-found: ignore
  # --- LINUX_TESTS-END ---------------------------------------------------------
  # --- NOT_SOLE_GO-END ---------------------------------------------------------
  # --- SWIFT-START -----------------------------------------------------------
  # Swift tests need a macOS runner (xcodebuild/xcrun are macOS-only). On a
  # self-hosted runner (SonarQube) that means registering a SELF-HOSTED macOS
  # runner and giving it the `macos` label — see SETUP.md; on GitHub-hosted
  # runners (SonarCloud) it is `macos-latest`. This job REPLACES the Linux
  # test-and-coverage job on Swift-only repos: its `name:` is the same
  # `test-and-coverage` context, so branch protection's required checks are
  # unchanged. When the Linux job was stripped (Swift-only), point the
  # analyser job's `needs:` at `test-and-coverage-swift` (see the bootstrap
  # skill's Swift notes; on a rare Swift+other-language repo keep both jobs,
  # extend `needs:` to both, and give this job's artifact a distinct name
  # plus a second download step).
  test-and-coverage-swift:
    name: test-and-coverage
    runs-on: {{SWIFT_RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Full history: diff-cover needs a merge base with origin/<base>,
          # and a shallow PR checkout has none (its parent link is cut).
          fetch-depth: 0

      # --- SWIFT_SWIFTPM-START -----------------------------------------------
      - name: Build + test with coverage (SwiftPM)
        run: swift test --enable-code-coverage
      - name: Export lcov (SwiftPM)
        # llvm-cov reads the profdata SwiftPM wrote next to the build
        # products; the .xctest bundle binary carries the instrumentation.
        run: |
          BIN_PATH=$(swift build --show-bin-path)
          XCTEST_BUNDLE=$(find "$BIN_PATH" -maxdepth 1 -name '*.xctest' | head -1)
          XCTEST_BIN="$XCTEST_BUNDLE/Contents/MacOS/$(basename "$XCTEST_BUNDLE" .xctest)"
          xcrun llvm-cov export "$XCTEST_BIN" \
            -instr-profile "$BIN_PATH/codecov/default.profdata" \
            -format=lcov \
            -ignore-filename-regex='(\.build|Tests)/' > coverage.lcov
      # --- SWIFT_SWIFTPM-END -------------------------------------------------

      # --- SWIFT_XCODE-START ---------------------------------------------------
      - name: Build + test with coverage (Xcode)
        run: |
          xcodebuild test \
            -scheme "{{XCODE_SCHEME}}" \
            -destination 'platform=macOS' \
            -derivedDataPath DerivedData \
            -enableCodeCoverage YES
      - name: Export lcov (Xcode)
        # llvm-cov needs the instrumented binaries plus the profdata that
        # xcodebuild wrote into DerivedData. The app binary is primary; every
        # .xctest binary is added via -object (unit-test-target coverage
        # lives there for library/framework schemes).
        run: |
          PROFDATA=$(find DerivedData -name 'Coverage.profdata' | head -1)
          APP_BIN=$(find DerivedData/Build/Products -type f -path '*.app/Contents/MacOS/*' | head -1)
          OBJECTS=()
          while IFS= read -r xctest; do
            OBJECTS+=(-object "$xctest/Contents/MacOS/$(basename "$xctest" .xctest)")
          done < <(find DerivedData/Build/Products -maxdepth 3 -name '*.xctest')
          xcrun llvm-cov export "$APP_BIN" "${OBJECTS[@]}" \
            -instr-profile "$PROFDATA" \
            -format=lcov \
            -ignore-filename-regex='(DerivedData|Tests)/' > coverage.lcov
      # --- SWIFT_XCODE-END -----------------------------------------------------

      # Coverage floor — 90% on new code (mirrors the Python/Java diff-cover
      # gate; diff-cover reads lcov natively). PR-only — push to the default
      # branch has no "new code" diff to enforce against.
      - name: Install diff-cover (Swift — coverage floor)
        if: github.event_name == 'pull_request'
        run: pipx install 'diff-cover>=9'
      - name: Coverage floor — 90% on new code (Swift)
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          diff-cover coverage.lcov \
            --compare-branch="origin/${BASE_REF}" \
            --fail-under=90 \
            --show-uncovered

      - name: Upload coverage artifact
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: coverage-reports
          path: coverage.lcov
          if-no-files-found: ignore
  # --- SWIFT-END ---------------------------------------------------------------
  # --- NOT_SOLE_GO-START -------------------------------------------------------

  # --- SONARQUBE-START -------------------------------------------------------
  sonarqube:
    needs: test-and-coverage
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: coverage-reports
          path: .
        # No continue-on-error: if test-and-coverage didn't produce coverage,
        # Sonar should fail loudly rather than silently report green without it.
      - name: SonarQube scan
        # The 40-hex commit pin trips semgrep's SonarQube-docs-API-key
        # detector; it's a git SHA, not a credential.
        # nosemgrep: generic.secrets.security.detected-sonarqube-docs-api-key.detected-sonarqube-docs-api-key
        uses: SonarSource/sonarqube-scan-action@d209202bc7d53ff1cc128f7f907dac145c9d6ae9 # v8.3
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
  # --- SONARQUBE-END ---------------------------------------------------------

  # --- SONARCLOUD-START ------------------------------------------------------
  sonarcloud:
    needs: test-and-coverage
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: Download coverage
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: coverage-reports
          path: .
        # No continue-on-error: if test-and-coverage didn't produce coverage,
        # Sonar should fail loudly rather than silently report green without it.
      - name: SonarCloud scan
        # The 40-hex commit pin trips semgrep's SonarQube-docs-API-key
        # detector; it's a git SHA, not a credential.
        # nosemgrep: generic.secrets.security.detected-sonarqube-docs-api-key.detected-sonarqube-docs-api-key
        uses: SonarSource/sonarqube-scan-action@d209202bc7d53ff1cc128f7f907dac145c9d6ae9 # v8.3
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: https://sonarcloud.io
  # --- SONARCLOUD-END --------------------------------------------------------

  # --- TRIVY-START -----------------------------------------------------------
  # Trivy filesystem scan — catches vulnerable 3rd-party deps in lockfiles.
  # Scoped to vuln/secret/misconfig only; license scanning is a separate job
  # for clearer triage (was this PR blocked by a CVE or by a license?).
  trivy-fs:
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: "fs"
          scan-ref: "."
          scanners: "vuln,secret,misconfig"
          ignore-unfixed: false
          severity: "CRITICAL,HIGH"
          exit-code: "1"
          format: "table"
          trivy-config: trivy.yaml
  # --- TRIVY-END -------------------------------------------------------------

  # --- SNYK-START ------------------------------------------------------------
  # Snyk's source-code + open-source scans are NOT a CI job: they run through
  # the Snyk GitHub integration (App), configured in the Snyk Web UI — see
  # SETUP.md's Snyk setup section. SAST on our own code stays with
  # {{SAST_GATE}}. The `image` job's Snyk container scan below is the one Snyk
  # step in CI, because the integration only scans the Dockerfile statically.
  # --- SNYK-END --------------------------------------------------------------

  # License compliance on dependencies — separate job so license failures
  # don't get conflated with vulnerability failures.
  license-fs:
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: "fs"
          scan-ref: "."
          scanners: "license"
          severity: "CRITICAL,HIGH"
          exit-code: "1"
          format: "table"
          trivy-config: trivy.yaml
  # --- NOT_SOLE_GO-END ---------------------------------------------------------

  # --- DOCKER-START ---------------------------------------------------------
  # Container image pipeline — two jobs (#547):
  #
  #   image (scan)      → PR + push + release: build linux/amd64, scan.
  #                       `contents: read` only — PR runs never execute a
  #                       job holding write-capable permissions.
  #   push-and-sign     → push/release only (`needs: image`): GHCR login,
  #                       multi-arch push, SBOM, provenance, cosign. Holds
  #                       `packages: write` + `id-token: write` — job
  #                       permissions can't be gated per-step, so the write
  #                       grants live in a job PRs never run.
  #
  # PR touching container files → build linux/amd64 only, scan, no push (gate)
  # PR NOT touching container files → no scan; the required `image` check
  #                           passes through (#386 — app/dependency PRs must not
  #                           be blocked by pre-existing base-image CVEs they
  #                           can't influence; "working on the app → app checks,
  #                           working on the image → container checks").
  # push to main / release  → build linux/amd64 + linux/arm64, scan, push to GHCR
  #
  # `image` stays a single required branch-protection context that ALWAYS
  # resolves: the job runs on every non-doc PR, but the build+scan steps are
  # gated on `scan_decision` so a non-container PR ends green without scanning.
  # `push-and-sign` never runs on PRs, so it is NOT a required check and
  # needs no noop mirror.
  image:
    runs-on: {{RUNNER}}
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Full history so the container-change detection below can diff the
          # PR against its base SHA.
          fetch-depth: 0

      # Decide whether the container scan should gate this run (#386). Gates
      # ONLY when the change touches the container definition; an app/dependency
      # PR that doesn't can't affect base-image CVEs, so it skips the scan and
      # the required `image` check passes. Non-PR events always scan. Fails SAFE
      # to scanning on any diff error.
      - name: Decide whether to scan the image
        id: scan_decision
        env:
          EVENT_NAME: ${{ github.event_name }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: |
          if [ "$EVENT_NAME" != "pull_request" ]; then
            echo "do_scan=true" >> "$GITHUB_OUTPUT"
            echo "Non-PR event ($EVENT_NAME) — scanning the image."
            exit 0
          fi
          # --- TRIVY-START ---
          container_re='(^|/)Dockerfile|\.dockerfile$|(^|/)\.dockerignore$|(^|/)(docker-compose|compose)\.ya?ml$|(^|/)trivy\.ya?ml$'
          # --- TRIVY-END ---
          # --- SNYK-START ---
          container_re='(^|/)Dockerfile|\.dockerfile$|(^|/)\.dockerignore$|(^|/)(docker-compose|compose)\.ya?ml$|(^|/)\.snyk$'
          # --- SNYK-END ---
          # --- DEFERRED_VULNERABILITIES-START ---
          container_re='(^|/)Dockerfile|\.dockerfile$|(^|/)\.dockerignore$|(^|/)(docker-compose|compose)\.ya?ml$'
          # --- DEFERRED_VULNERABILITIES-END ---
          if ! changed=$(git diff --name-only "$BASE_SHA" HEAD 2>/dev/null); then
            echo "do_scan=true" >> "$GITHUB_OUTPUT"
            echo "::warning::Could not compute the PR diff against $BASE_SHA — scanning to be safe."
            exit 0
          fi
          if printf '%s\n' "$changed" | grep -qE "$container_re"; then
            echo "do_scan=true" >> "$GITHUB_OUTPUT"
            echo "Container-relevant files changed — running the image scan gate:"
            printf '%s\n' "$changed" | grep -E "$container_re" || true
          else
            echo "do_scan=false" >> "$GITHUB_OUTPUT"
            echo "::notice::No container files changed; skipping image scan (#386). Required 'image' check passes."
          fi

      # ARTIFACT BUILD STEPS anchor (#545): if the Dockerfile COPYs build
      # outputs (build/, dist/, target/, ...), the bootstrap inserts the
      # steps that produce them here — gated on scan_decision like the
      # image build below (e.g. setup-java + setup-gradle + the Gradle dist
      # task). Mirror the same steps in push-and-sign, which builds the
      # image again on its own runner.

      - name: Set up QEMU (for foreign-arch emulation)
        uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4.4.0

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      - name: Compute image tags
        id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302 # v6.2.0
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=sha,format=short,prefix=sha-
            type=raw,value=latest,enable={{is_default_branch}}
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}}

      # Single-arch build for scanning. Loading multi-arch images into the
      # local docker daemon isn't supported.
      - name: Build image (amd64 only, for scanning)
        if: steps.scan_decision.outputs.do_scan == 'true'
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          platforms: linux/amd64
          load: true
          push: false
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          # mode=min on the scan build keeps PR-time cache writes minimal.
          # The push build below uses mode=max (only fires on trusted ref).
          cache-to: type=gha,mode=min

      - name: Pick a tag for scanning
        id: pick
        if: steps.scan_decision.outputs.do_scan == 'true'
        run: |
          tag=$(echo '${{ steps.meta.outputs.tags }}' | head -n1)
          echo "tag=$tag" >> "$GITHUB_OUTPUT"

      # --- TRIVY-START -------------------------------------------------------
      - name: Trivy image vulnerability scan
        if: steps.scan_decision.outputs.do_scan == 'true'
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          scan-type: "image"
          image-ref: ${{ steps.pick.outputs.tag }}
          scanners: "vuln,secret,misconfig"
          ignore-unfixed: false
          severity: "CRITICAL,HIGH"
          exit-code: "1"
          format: "table"
          trivy-config: trivy.yaml
      # --- TRIVY-END ---------------------------------------------------------

      # --- SNYK-START --------------------------------------------------------
      - name: Snyk container scan
        if: steps.scan_decision.outputs.do_scan == 'true'
        uses: snyk/actions/setup@9adf32b1121593767fc3c057af55b55db032dc04 # v1.0.0
      - if: steps.scan_decision.outputs.do_scan == 'true'
        run: |
          # --policy-path makes Snyk read .snyk ignores for container scans
          # (it doesn't auto-discover the policy file in container mode).
          # --json-file-output writes the full machine-readable report
          # regardless of exit code, so the scan still gates the GHCR push
          # below while also producing the artifact harvested next.
          snyk container test "${{ steps.pick.outputs.tag }}" \
            --severity-threshold=high --file=Dockerfile --policy-path=.snyk \
            --json-file-output=snyk-container.json
        env:
          SNYK_TOKEN: ${{ secrets.SNYK_TOKEN }}

      # Harvest the container scan as a CI artifact so the maintenance
      # pipeline (/development:maintenance) can ingest base-image CVEs.
      # Gated to push/release: the artifact describes the pushed image.
      # `always()` so it still uploads when the scan exited non-zero.
      - name: Upload Snyk container scan (for maintenance ingestion)
        if: always() && (github.event_name == 'push' || github.event_name == 'release')
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: snyk-container-scan
          path: snyk-container.json
          if-no-files-found: error
          retention-days: 90
      # --- SNYK-END ----------------------------------------------------------

      # NOTE: image-level license scan intentionally omitted. Trivy's
      # `restricted` classification flags every transitive Debian GPL/LGPL
      # library inside the base image (libxml2, libgnutls, libreadline, etc.).
      # We use those via OS-level dynamic linking, not by embedding them in
      # a derivative — copyleft obligations don't apply. The license-fs job
      # already covers what matters: the project's own declared dependencies.

  # Publish job — the ONLY job holding write-capable permissions, and it
  # never runs on PRs. `needs: image` makes the scan gate the push: a
  # vulnerable image never reaches the registry. Multi-arch via QEMU on the
  # runner. If a self-hosted runner is an Apple Silicon Mac, the
  # linux/arm64 build is native (fast) and linux/amd64 is QEMU-emulated; on
  # an Intel Mac or Linux x86 host it's the reverse.
  push-and-sign:
    needs: image
    if: github.event_name == 'push' || github.event_name == 'release'
    runs-on: {{RUNNER}}
    permissions:
      contents: read
      packages: write    # ghcr.io push
      id-token: write    # cosign keyless OIDC signing
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # ARTIFACT BUILD STEPS anchor (#545): mirror the artifact build steps
      # from the image (scan) job here, unconditional — this job builds the
      # image again and the scan job's workspace doesn't carry over.

      - name: Set up QEMU (for foreign-arch emulation)
        uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4.4.0

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      # Recomputed rather than passed from the scan job — step outputs don't
      # cross job boundaries, and metadata-action is deterministic for the
      # same ref.
      - name: Compute image tags
        id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302 # v6.2.0
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=sha,format=short,prefix=sha-
            type=raw,value=latest,enable={{is_default_branch}}
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}}

      - name: Login to GHCR
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build + push multi-arch image (with SBOM + provenance)
        id: build-push
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          # CycloneDX JSON SBOM via Syft, attached as OCI artifact.
          sbom: true
          # SLSA provenance attestation.
          provenance: mode=max
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Pick a tag for the SBOM export
        id: pick
        run: |
          tag=$(echo '${{ steps.meta.outputs.tags }}' | head -n1)
          echo "tag=$tag" >> "$GITHUB_OUTPUT"

      - name: Export SBOM as CI artifact
        uses: anchore/sbom-action@66cbf4bc1f1c0d2edc94016e65bc221b6bb0ad6c # v0.24.3
        with:
          image: ${{ steps.pick.outputs.tag }}
          format: cyclonedx-json
          output-file: sbom.cdx.json

      - name: Validate SBOM is well-formed CycloneDX
        run: |
          docker run --rm -v "$PWD:/work" cyclonedx/cyclonedx-cli:v0.32.0 \
            validate --input-file /work/sbom.cdx.json --input-format json --fail-on-errors

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: sbom-cyclonedx-${{ github.sha }}
          path: sbom.cdx.json
          retention-days: 90

      # Sign the image with Sigstore cosign — keyless OIDC, no key
      # management. The signature is stored alongside the image in the
      # registry. Verifiable with `cosign verify` using the workflow's
      # OIDC certificate identity.
      - name: Install cosign
        uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2

      - name: Sign image with cosign (keyless OIDC)
        env:
          IMAGE_DIGEST: ${{ steps.build-push.outputs.digest }}
          TAGS: ${{ steps.meta.outputs.tags }}
        run: |
          for tag in $TAGS; do
            cosign sign --yes "${tag}@${IMAGE_DIGEST}"
          done
  # --- DOCKER-END -----------------------------------------------------------

  # --- NOT_SOLE_GO-START -------------------------------------------------------
  # Semgrep — two shapes by runner. A self-hosted runner (SonarQube) reuses a
  # semgrep it already has; GitHub-hosted runners (SonarCloud, or no static
  # analyser at all — HOSTED, #2121) run the pinned container image, exactly as
  # the public workflow does.
  semgrep:
    runs-on: {{RUNNER}}
    # --- HOSTED-START --------------------------------------------------------
    container:
      # Pinned. Matches the pre-commit hook's semgrep version so local + CI
      # behave identically. Bump in lockstep with `.pre-commit-config.yaml`.
      image: returntocorp/semgrep:1.163.0
    # --- HOSTED-END ----------------------------------------------------------
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # --- SELF_HOSTED-START -------------------------------------------------
      - run: |
          if ! command -v semgrep >/dev/null; then
            pip install --user semgrep
            export PATH="$HOME/.local/bin:$PATH"
          fi
          semgrep ci --config=auto
      # --- SELF_HOSTED-END ---------------------------------------------------
      # --- HOSTED-START ------------------------------------------------------
      - run: semgrep ci --config=auto
        env:
          SEMGREP_APP_TOKEN: ${{ secrets.SEMGREP_APP_TOKEN }}   # optional
      # --- HOSTED-END --------------------------------------------------------

  # --- Pre-commit (CI backstop) ---------------------------------------------
  # Catches contributors who bypassed local hooks with `git commit
  # --no-verify`. Runs the exact same hooks as locally.
  pre-commit:
    runs-on: {{RUNNER}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0   # some hooks (gitleaks) want history
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
        with:
          python-version: "{{PYTHON_VERSION}}"
      # --- GO-START ----------------------------------------------------------
      # pre-commit builds the golangci-lint hook with the `go` on PATH, and
      # golangci-lint refuses a module whose go.mod targets a newer Go than it
      # was built with — so build it with go.mod's Go, not the runner's (#2621).
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7
        with:
          go-version-file: go.mod
      # pre-commit/action keys its hook cache on .pre-commit-config.yaml alone,
      # so a go.mod Go bump would restore the hook built with the old Go. These
      # steps are pre-commit/action's own, with go.mod added to the key (#2869).
      # The hook home is under runner.temp, which every job starts empty, so a
      # self-hosted runner's persisting ~/.cache/pre-commit is never reused.
      - run: python -m pip install pre-commit
      - run: echo "PRE_COMMIT_HOME=$RUNNER_TEMP/pre-commit" >> "$GITHUB_ENV"
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/pre-commit
          key: pre-commit-go|${{ env.pythonLocation }}|${{ hashFiles('.pre-commit-config.yaml', 'go.mod') }}
      - run: pre-commit run --show-diff-on-failure --color=always --all-files
      # --- GO-END ------------------------------------------------------------
      # --- NOT_GO-START ------------------------------------------------------
      - uses: pre-commit/action@2c7b3805fd2a0fd8c1884dcaebf91fc102a13ecd # v3.0.1
      # --- NOT_GO-END --------------------------------------------------------
      # --- HOSTED-START ------------------------------------------------------
      # --- TRIVY-START -------------------------------------------------------
        # GitHub-hosted runners carry no trivy binary for the local trivy-fs hook;
        # the trivy-fs job above runs the same scan, so skip the hook here.
        env:
          SKIP: trivy-fs
      # --- TRIVY-END ---------------------------------------------------------
      # --- HOSTED-END --------------------------------------------------------
  # --- NOT_SOLE_GO-END ---------------------------------------------------------
