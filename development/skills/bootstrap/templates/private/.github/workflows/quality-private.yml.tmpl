# Quality + security pipeline for PRIVATE repositories.
# Runs on a self-hosted runner that can reach the local SonarQube instance.
# Uses SonarQube CE for static analysis + coverage and Trivy for security
# (filesystem deps + container image).
#
# Image publishing: built image is scanned, then pushed to GitHub Container
# Registry (ghcr.io/<owner>/<repo>) on merge to main + release events. The
# scan gates the push — a vulnerable image never reaches the registry.

name: Quality (private)

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths-ignore:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths-ignore:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"
  release:
    types: [published]
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write
  security-events: write
  packages: write          # required for ghcr.io push

concurrency:
  group: quality-${{ github.ref }}
  cancel-in-progress: true

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  test-and-coverage:
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # --- TYPESCRIPT-START ------------------------------------------------
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
      - run: |
          npm ci
          npm test -- --coverage
      # --- TYPESCRIPT-END --------------------------------------------------

      # --- PYTHON-START ----------------------------------------------------
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"
      - run: |
          pip install -r requirements.txt || pip install -e ".[dev]"
          pytest --cov --cov-report=xml --cov-report=term
      # --- PYTHON-END ------------------------------------------------------

      # --- GO-START --------------------------------------------------------
      - uses: actions/setup-go@v5
        with:
          go-version: "stable"
      - run: go test ./... -coverprofile=coverage.out -covermode=atomic
      # --- GO-END ----------------------------------------------------------

      # --- SWIFT-START -----------------------------------------------------
      # Switch this job's runner to a macOS self-hosted runner for Swift.
      - if: false   # placeholder for Swift projects
        run: echo "Configure macOS self-hosted runner + xcodebuild test for Swift."
      # --- SWIFT-END -------------------------------------------------------

      - uses: actions/upload-artifact@v4
        with:
          name: coverage-reports
          path: |
            coverage.xml
            coverage.out
            coverage.lcov
            coverage/lcov.info
          if-no-files-found: ignore

  sonarqube:
    needs: test-and-coverage
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@v4
        with:
          name: coverage-reports
          path: .
        continue-on-error: true
      - name: SonarQube scan
        uses: SonarSource/sonarqube-scan-action@v5
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}

  # Trivy filesystem scan — catches vulnerable 3rd-party deps in lockfiles.
  trivy-fs:
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v4
      - uses: aquasecurity/trivy-action@0.28.0
        with:
          scan-type: "fs"
          scan-ref: "."
          ignore-unfixed: false
          severity: "CRITICAL,HIGH"
          exit-code: "1"
          format: "table"
          trivy-config: trivy.yaml

  # --- DOCKER-START ---------------------------------------------------------
  # Container image pipeline.
  #
  # PRs                     → build linux/amd64 only, scan, no push (fast)
  # push to main / release  → build linux/amd64 + linux/arm64, scan, push to GHCR
  #
  # Multi-arch via QEMU on the self-hosted runner. If your runner is an
  # Apple Silicon Mac, the linux/arm64 build is native (fast) and linux/amd64
  # is QEMU-emulated; on an Intel Mac or Linux x86 host it's the reverse.
  image:
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v4

      - name: Set up QEMU (for foreign-arch emulation)
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Compute image tags
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=sha,format=short,prefix=sha-
            type=raw,value=latest,enable={{is_default_branch}}
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}}

      # Single-arch build for scanning. Loading multi-arch images into the
      # local docker daemon isn't supported.
      - name: Build image (amd64 only, for scanning)
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64
          load: true
          push: false
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Pick a tag for scanning
        id: pick
        run: |
          tag=$(echo '${{ steps.meta.outputs.tags }}' | head -n1)
          echo "tag=$tag" >> "$GITHUB_OUTPUT"

      - name: Trivy image scan
        uses: aquasecurity/trivy-action@0.28.0
        with:
          scan-type: "image"
          image-ref: ${{ steps.pick.outputs.tag }}
          ignore-unfixed: false
          severity: "CRITICAL,HIGH"
          exit-code: "1"
          format: "table"
          trivy-config: trivy.yaml

      - name: Login to GHCR
        if: github.event_name == 'push' || github.event_name == 'release'
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build + push multi-arch image
        if: github.event_name == 'push' || github.event_name == 'release'
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
  # --- DOCKER-END -----------------------------------------------------------

  semgrep:
    runs-on: self-hosted
    steps:
      - uses: actions/checkout@v4
      - run: |
          if ! command -v semgrep >/dev/null; then
            pip install --user semgrep
            export PATH="$HOME/.local/bin:$PATH"
          fi
          semgrep ci --config=auto
