# Doc-only PR companion for quality-private.yml — see the public
# workflow's noop header for the rationale and mixed-PR caveat. Runs on the
# same runner as the main workflow, so on a self-hosted runner (SonarQube) the
# noop ALSO exercises the runner availability (a self-hosted runner being down
# would otherwise silently fail to satisfy required-checks even on doc-only
# PRs). Its jobs mirror the main workflow's required checks for the resolved
# toolchain.

name: Quality (private) — docs noop

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"

permissions:
  contents: read

jobs:
  test-and-coverage:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping tests."

  # --- SONARQUBE-START -------------------------------------------------------
  sonarqube:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping SonarQube scan."
  # --- SONARQUBE-END ---------------------------------------------------------

  # --- SONARCLOUD-START ------------------------------------------------------
  sonarcloud:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping SonarCloud scan."
  # --- SONARCLOUD-END --------------------------------------------------------

  # --- TRIVY-START -----------------------------------------------------------
  trivy-fs:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping trivy filesystem scan."
  # --- TRIVY-END -------------------------------------------------------------

  license-fs:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping license scan."

  semgrep:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping semgrep scan."

  pre-commit:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping pre-commit."

  # --- DOCKER-START ---------------------------------------------------------
  image:
    runs-on: {{RUNNER}}
    steps:
      - run: echo "Doc-only PR — skipping image build/scan."
  # --- DOCKER-END -----------------------------------------------------------
