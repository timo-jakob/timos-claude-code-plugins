# Dependabot config — automated dependency updates.
# Ecosystem entries below are added by the bootstrap skill based on detected
# languages. github-actions is always included.

version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      actions-minor-patch:
        update-types: ["minor", "patch"]

  # --- JAVASCRIPT-START ------------------------------------------------------
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
    groups:
      npm-minor-patch:
        update-types: ["minor", "patch"]
  # --- JAVASCRIPT-END --------------------------------------------------------

  # --- PYTHON-START ----------------------------------------------------------
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      pip-minor-patch:
        update-types: ["minor", "patch"]
  # --- PYTHON-END ------------------------------------------------------------

  # --- GO-START --------------------------------------------------------------
  - package-ecosystem: "gomod"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      gomod-minor-patch:
        update-types: ["minor", "patch"]
  # --- GO-END ----------------------------------------------------------------

  # --- SWIFT-START -----------------------------------------------------------
  - package-ecosystem: "swift"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      swift-minor-patch:
        update-types: ["minor", "patch"]
  # --- SWIFT-END -------------------------------------------------------------

  # --- JAVA-START ------------------------------------------------------------
  # Tracks Gradle dependencies (build.gradle(.kts), gradle/libs.versions.toml).
  - package-ecosystem: "gradle"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      gradle-minor-patch:
        update-types: ["minor", "patch"]
  # --- JAVA-END --------------------------------------------------------------

  # --- DOCKER-START ----------------------------------------------------------
  # Tracks the FROM line(s) in your Dockerfile(s). Without this, a CVE in
  # `python:3.12-slim` or `node:20-alpine` lingers indefinitely because
  # nothing pulls the latest tag.
  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      docker-minor-patch:
        update-types: ["minor", "patch"]
  # --- DOCKER-END ------------------------------------------------------------
