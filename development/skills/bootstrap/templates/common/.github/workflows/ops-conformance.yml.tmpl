# Ops Conformance — prove the running service exposes the org-standard ops
# surface (epic #682, design §5; issue #688).
#
# The ops-api/v1 fragment defines /info, /health, /metrics as a versioned
# contract; contracts-lint/contracts-semver keep the SPEC honest, and THIS job
# keeps the RUNNING SERVICE honest — it starts the canonical container, waits for
# /health/ready, then runs scripts/check-ops-conformance.zsh against it. A drift
# between the deployed service and the fragment fails the check.
#
# Standalone by design (independent of epic #704's rest harness); #704 may later
# fold it into the `acceptance (rest)` leg. Generated by /development:bootstrap.
# Source template:
# development/skills/bootstrap/templates/common/.github/workflows/ops-conformance.yml.tmpl
name: ops-conformance

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths:
      - "contracts/ops/**"
      - "scripts/check-ops-conformance.zsh"
      - "Dockerfile"
      - ".github/workflows/ops-conformance.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: ops-conformance-${{ github.ref }}
  cancel-in-progress: true

jobs:
  ops-conformance:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      # The ops surface is served on the internal MANAGEMENT port (default 9090),
      # never the public app port — so /info is unreachable externally. The
      # container maps its management port to 9090; override if your service
      # differs.
      OPS_BASE_URL: "http://localhost:9090"
      OPS_PORT: "9090"
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6

      - name: Install checker toolchain (jq; zsh + curl ship on the runner)
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends jq zsh >/dev/null

      - name: Build the canonical container
        run: docker build -t ops-conformance-svc .

      - name: Start the service
        run: |
          set -euo pipefail
          docker run -d --name ops-svc -p "${OPS_PORT}:${OPS_PORT}" ops-conformance-svc

      - name: Wait for readiness
        run: |
          set -euo pipefail
          for i in $(seq 1 30); do
            if curl -fsS -m 2 "${OPS_BASE_URL}/health/ready" >/dev/null 2>&1; then
              echo "service is ready after ${i} attempt(s)"; exit 0
            fi
            sleep 2
          done
          echo "::error::service did not become ready at ${OPS_BASE_URL}/health/ready"
          docker logs ops-svc || true
          exit 1

      - name: Run ops conformance
        run: zsh scripts/check-ops-conformance.zsh "${OPS_BASE_URL}"

      - name: Service logs (always)
        if: always()
        run: docker logs ops-svc || true

      - name: Tear down
        if: always()
        run: docker rm -f ops-svc || true
