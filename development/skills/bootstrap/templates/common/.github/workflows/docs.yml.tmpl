# Docs build gate — installed by /development:bootstrap (#766, epic #745).
#
# Two jobs, both part of the PR gate, path-conditional on the docs surface only
# (the app-vs-container check-separation policy: docs builds must never block
# app PRs that don't touch docs):
#   - build:    MkDocs-Material site with `--strict` (a broken internal link or
#               any build warning fails the check).
#   - pdf-epub: pandoc builds manual.pdf + manual.epub from the SAME nav order
#               (derived by scripts/docs-nav-to-chapters.zsh), so the manuals
#               can't drift from the site; a pandoc failure fails the gate.
# Publication (Pages deploy, docs-latest assets, OCI image) happens on the
# default branch via docs-deploy.yml / docs-publish.yml; this workflow only
# gates. Keep these checks OUT of branch protection's required contexts —
# path-conditional checks don't run on non-docs PRs.

name: docs

on:
  pull_request:
    paths:
      - "docs/**"
      - "mkdocs.yml"
      - "requirements-docs.txt"
      - "scripts/docs-nav-to-chapters.zsh"
      - "scripts/pandoc/**"
      - ".github/workflows/docs.yml"
  push:
    branches: [{{DEFAULT_BRANCH}}]
    paths:
      - "docs/**"
      - "mkdocs.yml"
      - "requirements-docs.txt"
      - "scripts/docs-nav-to-chapters.zsh"
      - "scripts/pandoc/**"
      - ".github/workflows/docs.yml"

permissions:
  contents: read

concurrency:
  group: docs-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1  # v6
        with:
          python-version: "3.12"

      - name: Install the docs toolchain
        run: pip install -r requirements-docs.txt

      - name: Build the site (strict — broken internal links fail the build)
        run: mkdocs build --strict

  pdf-epub:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6

      - name: Install zsh (for the nav->chapters converter)
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq zsh

      - name: Derive chapter order from the mkdocs nav
        run: ./scripts/docs-nav-to-chapters.zsh > chapters.txt

      - name: Build manual.pdf + manual.epub with pandoc
        # Pinned official pandoc/extra container (xelatex plus the wider TeX Live
        # set — fvextra, which scripts/pandoc/manual-header.tex needs to wrap long
        # code lines; pandoc/latex does not carry it). The repo's dependency bot
        # keeps the tag current.
        #
        # The PDF adds two layout fixes the ePub does not need, because HTML wraps
        # what LaTeX will not: a Lua filter that gives long paths and identifiers
        # somewhere to break, and a header that sets the page (A4, 25 mm margins),
        # wraps code blocks and maps the characters Latin Modern has no glyph for.
        # Without them a long path in a table cell prints over the neighbouring
        # column, a long code line runs off the page, a character with no glyph is
        # dropped silently, and the manual sets on US letter with the article
        # class's ~47 mm margins — a page of white with a manual in the middle.
        #
        # `fontsize` is a document-class option, so it cannot live in the header
        # with the rest of the page setup — it has to be set here. 11 pt is what
        # makes that page readable: the header's A4 geometry gives a 160 mm column,
        # which runs to ~100 characters a line at the class's 10 pt default and
        # ~85 at 11 pt. Change one of the two and re-read a page.
        run: |
          set -euo pipefail
          mapfile -t chapters < chapters.txt
          docker run --rm -v "$PWD:/data" -w /data pandoc/extra:3.5 \
            --pdf-engine=xelatex --toc \
            -V fontsize=11pt \
            --metadata title="{{PROJECT_NAME}}" \
            --metadata author="{{PROJECT_SLUG}}" \
            --lua-filter=scripts/pandoc/break-long-tokens.lua \
            --include-in-header=scripts/pandoc/manual-header.tex \
            -o manual.pdf "${chapters[@]}" 2>&1 | tee pandoc-pdf.log
          docker run --rm -v "$PWD:/data" -w /data pandoc/extra:3.5 \
            --toc --metadata title="{{PROJECT_NAME}}" \
            --metadata author="{{PROJECT_SLUG}}" \
            -o manual.epub "${chapters[@]}"

      - name: Confirm both manuals were produced
        run: test -s manual.pdf && test -s manual.epub

      - name: Fail on characters the PDF has no glyph for
        # xelatex drops an unmapped character SILENTLY — "≥90% coverage" would
        # print as "90% coverage". Without this gate that loss is a warning
        # nobody reads.
        run: |
          set -euo pipefail
          if grep "Missing character" pandoc-pdf.log; then
            echo "::error::xelatex dropped the characters above from manual.pdf."
            echo "Add a \\DeclareUnicodeFallback for each one to scripts/pandoc/manual-header.tex."
            exit 1
          fi

      - name: Fail on references the PDF cannot resolve
        # An in-page link whose target heading the site and the manual spell
        # differently resolves on the site and dangles in the PDF (#1542) —
        # pandoc reports it and still exits 0, so without this gate the dead
        # link ships.
        #
        # The verdict is a NEGATIVE test: on a clean manual pandoc prints
        # nothing, so "no dangling link" and "the warning never reached the log"
        # look identical. The probe is the positive control — it builds a
        # two-line document whose only link dangles and requires the warning to
        # appear, so a pandoc image that stops relaying the LaTeX log reds here
        # instead of leaving the gate silently blind. It writes nothing into the
        # workspace.
        run: |
          set -euo pipefail
          probe_log="$(docker run --rm --entrypoint sh pandoc/extra:3.5 -c \
            'printf "# Probe\n\nA [dangling](#no-such-anchor) link.\n" > /tmp/probe.md
             pandoc --pdf-engine=xelatex -o /tmp/probe.pdf /tmp/probe.md' 2>&1)" || {
            printf '%s\n' "$probe_log"
            echo "::error::the pandoc probe container failed (above) — that is infrastructure, not a"
            echo "pandoc behaviour change. Re-run the job; do NOT re-key this gate."
            exit 1
          }
          if ! printf '%s\n' "$probe_log" | grep -q "There were undefined references"; then
            printf '%s\n' "$probe_log"
            echo "::error::pandoc ran but no longer reports undefined references, so this gate cannot fail."
            echo "Re-key it on what the current pandoc image emits before trusting a green run."
            exit 1
          fi
          test -s pandoc-pdf.log || {
            echo "::error::pandoc-pdf.log is missing or empty — the manual was never judged."
            exit 1
          }
          if grep -q "There were undefined references" pandoc-pdf.log; then
            grep -B2 -A2 "undefined" pandoc-pdf.log
            echo "::error::manual.pdf has unresolved references — the links above work on the site only."
            echo "If the anchor names a heading that exists, give that heading an explicit {#id} —"
            echo "the id that heading ALREADY publishes on the default branch, pasted verbatim."
            echo "Never guess the slug: a guessed id greens this gate while moving the published"
            echo "anchor, which breaks every bookmark and inbound link to that heading."
            echo "If it names no heading in the page (renamed, deleted or a typo), fix the link."
            exit 1
          fi
