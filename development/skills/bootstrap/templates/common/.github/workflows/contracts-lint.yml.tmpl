# Contracts Lint — Spectral over the versioned OpenAPI contracts (issue #692).
#
# The API contract is a published, versioned artifact, so it must stay clean.
# Spectral lints every contracts/vN/openapi.yaml against the ruleset at
# .spectral.yaml (repo root). The ruleset CONTENT is replaceable (the org
# styleguide epic #689 swaps it) — this workflow references it BY PATH, so a
# ruleset change never touches this wiring.
name: Contracts Lint

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths:
      - "contracts/**"
      - ".spectral.yaml"
      - ".github/workflows/contracts-lint.yml"

# Least privilege: linting only reads the checked-out tree.
permissions:
  contents: read

jobs:
  spectral:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6

      - name: Setup Node
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: "20"

      - name: Lint OpenAPI contracts with Spectral
        run: |
          set -euo pipefail
          shopt -s nullglob
          # The per-major business API (contracts/vN) AND the org-standard ops
          # surface (contracts/ops/vN, #688) are both versioned contract
          # artifacts, so both are linted against the same ruleset.
          #
          # ONLY THE NEWEST MAJOR OF EACH FAMILY IS LINTED (#1330). A frozen older
          # major is immutable by contract — a breaking change is a new major,
          # never an in-place edit — so linting it against a ruleset cut AFTER it
          # was frozen can only produce red that nobody is permitted to fix. That
          # is not hypothetical: the org styleguide's org-problem-json-errors
          # (#689) reddens every ops/v1 fragment, on a file the repo did not write.
          #
          # NOTE the consequence, because it is a real trap: a repo that never
          # adopts a newer major keeps the old one as its newest, and it IS still
          # linted. Migration is mandatory and documented, not optional — see
          # docs/how-to/adopt-the-ops-surface.md.
          # Explicit `if`s rather than `[[ … ]] && …` tails: under `set -e` a false
          # tail makes the enclosing list non-zero, which is a footgun that reads
          # as working code right up until the last family matches nothing.
          newest_major() {
            local candidates=("$1"/v[0-9]*/openapi.yaml)
            if [[ ${#candidates[@]} -eq 0 ]]; then
              return 0
            fi
            # sort -V so v10 beats v9; a plain sort picks v9 lexically.
            printf '%s\n' "${candidates[@]}" | sort -V | tail -1
          }
          specs=()
          for family in contracts contracts/ops; do
            spec="$(newest_major "$family")"
            if [[ -n "$spec" ]]; then
              specs+=("$spec")
            fi
          done
          if [[ ${#specs[@]} -eq 0 ]]; then
            echo "No contracts/vN/openapi.yaml found — nothing to lint."
            exit 0
          fi
          echo "Linting: ${specs[*]}"
          npx --yes @stoplight/spectral-cli@6 lint \
            --ruleset .spectral.yaml \
            --fail-severity error \
            "${specs[@]}"
