# Contract Semver — mechanical API semver gate over the per-major contracts/
# layout (issue #693, child (b) of epic #684).
#
# API semver is a MECHANICAL gate, not a convention. On every PR touching
# contracts/, the gate enforces the version triangle (info.version major == vN
# directory == servers URL major) and classifies each CHANGED major's diff
# against the base ref with oasdiff — the info.version bump must be sufficient
# (breaking -> ship a new major directory, never in-place; additive -> at least
# a minor bump; editorial -> at least a patch bump so the spec republishes). Old
# (non-newest) majors are frozen (editorial only). A human cannot quietly ship a
# breaking change as a minor.
#
# The verdict is produced by .github/scripts/check-contracts-semver.sh (its exit
# code gates this workflow); the findings JSON is uploaded for the Approver.
#
# Generated by /development:bootstrap when an OpenAPI surface is detected. Source
# template:
# development/skills/bootstrap/templates/common/.github/workflows/contracts-semver.yml.tmpl
name: Contract Semver

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths:
      - "contracts/**"
      - ".github/scripts/check-contracts-semver.sh"
      - ".github/workflows/contracts-semver.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: contracts-semver-${{ github.ref }}
  cancel-in-progress: true

jobs:
  contracts-semver:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
          # the gate diffs each contracts/vN spec against the base ref, so it
          # needs the base branch available locally
          fetch-depth: 0

      - name: Install oasdiff
        env:
          OASDIFF_VERSION: "1.11.7"
        run: |
          set -euo pipefail
          curl -fsSL "https://raw.githubusercontent.com/oasdiff/oasdiff/v${OASDIFF_VERSION}/install.sh" \
            | version="${OASDIFF_VERSION}" sh
          oasdiff --version

      - name: Run the contract semver gate
        run: |
          # The business API (contracts/vN) and the org-standard ops surface
          # (contracts/ops/vN, #688) are both versioned artifacts and get the
          # identical triangle + bump gate. Run BOTH unconditionally and OR their
          # exit codes. Running the ops invocation even when HEAD has no
          # contracts/ops/ is deliberate: the inner script self-guards an absent
          # surface (no majors at head or base -> exit 0), and this is what lets
          # it reject a `git rm -r contracts/ops/` that retires a live ops major
          # (detected against the base ref) — a guard testing HEAD-only existence
          # would skip exactly that violation. Both findings files are produced
          # for the Approver even when one half fails.
          rc=0
          bash .github/scripts/check-contracts-semver.sh \
            --base-ref "origin/{{DEFAULT_BRANCH}}" \
            --output contracts-semver-findings.json || rc=$?
          bash .github/scripts/check-contracts-semver.sh \
            --base-ref "origin/{{DEFAULT_BRANCH}}" \
            --contracts-dir contracts/ops \
            --output contracts-ops-semver-findings.json || rc=$?
          exit "$rc"

      - name: Upload findings artifact
        # if: always() so the Approver can read the report even when the gate
        # failed — the whole point of the two-layer design.
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: contracts-semver-${{ github.event.pull_request.number || github.sha }}
          # both the business-API and the ops-surface (#688) findings, when present
          path: |
            contracts-semver-findings.json
            contracts-ops-semver-findings.json
          if-no-files-found: ignore
          retention-days: 30

      - name: Job summary
        if: always()
        run: |
          set -euo pipefail
          summarize() { # $1 = findings file, $2 = heading
            [[ -f "$1" ]] || return 0
            echo "## $2"
            echo
            majors="$(jq -r '.majors | join(", ")' "$1")"
            echo "- **Live majors:** ${majors:-none}"
            n="$(jq -r '.violations | length' "$1")"
            echo "- **Violations:** ${n}"
            if [[ "$n" -gt 0 ]]; then
              echo
              echo "### Violations"
              echo
              jq -r '.violations[] | "- " + .' "$1"
            fi
            echo
          }
          {
            summarize contracts-semver-findings.json "Contract Semver Gate"
            summarize contracts-ops-semver-findings.json "Ops Contract Semver Gate (#688)"
          } >> "$GITHUB_STEP_SUMMARY"
