# Spec Publish — publish each live API major as an npm spec package (issue #692).
#
# npm is the MACHINE channel: consumers pin the package in package.json and
# Renovate bumps it, so a frontend can only ever see a published, versioned,
# backward-compat-gated contract — drift is structurally impossible, not policed.
# The default package name is the unscoped `<repo>-api-spec`; rename it (and add
# an npm scope) to suit your org.
#
# ONE version line PER LIVE MAJOR (contracts/vN/): this workflow discovers the
# majors at runtime and publishes each under a `major-vN` dist-tag (a bare `vN`
# is rejected by npm as a valid semver range), so the 1.x and 2.x consumer
# populations are both served natively — no re-bootstrap when a new major added.
#
# The npm package version IS the spec's info.version (the version triangle, #693),
# and this workflow refuses to publish a major whose info.version major disagrees
# with its vN directory. Re-publishing an already-published version is a clean
# no-op (a routine app release with no contract change stays green).
#
# The optional APIM governance channel (#706) publishes the same spec + docs to a
# human-facing portal and deploys the apim/ proxy config-as-code — in the SAME
# job, so it can never drift from npm. It is PRESENCE-GATED: the two portal steps
# below run only when an apim/ directory exists and SKIP with no failure
# otherwise, so a repo without apim/ gets the full drift guarantee from the npm
# channel alone. Its portal/proxy commands are org-specific reference placeholders
# you replace with your platform's CLI (see the steps).
#
# Requires an `NPM_TOKEN` repository secret with publish rights; the APIM channel
# additionally uses `APIM_ENDPOINT` + `APIM_TOKEN` (only when apim/ is present).
name: Spec Publish

on:
  release:
    types: ["published"]
  workflow_dispatch:

# Least privilege at workflow scope; jobs only read the tree.
permissions:
  contents: read

jobs:
  discover:
    runs-on: ubuntu-latest
    outputs:
      majors: ${{ steps.find.outputs.majors }}
      has_majors: ${{ steps.find.outputs.has_majors }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6

      - name: Discover live API majors
        id: find
        run: |
          set -euo pipefail
          shopt -s nullglob
          majors=()
          # v[0-9]* only — a per-major dir is v1, v2, …; never contracts/vendor/.
          for d in contracts/v[0-9]*/; do
            [[ -f "${d}openapi.yaml" ]] && majors+=("$(basename "$d")")
          done
          if [[ ${#majors[@]} -eq 0 ]]; then
            echo "has_majors=false" >> "$GITHUB_OUTPUT"
            echo "majors=[]" >> "$GITHUB_OUTPUT"
            echo "No contracts/vN/openapi.yaml found — nothing to publish."
            exit 0
          fi
          json="$(printf '%s\n' "${majors[@]}" | jq -R . | jq -cs .)"
          echo "has_majors=true" >> "$GITHUB_OUTPUT"
          echo "majors=${json}" >> "$GITHUB_OUTPUT"
          echo "Live majors: ${json}"

  publish:
    needs: discover
    if: needs.discover.outputs.has_majors == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        major: ${{ fromJson(needs.discover.outputs.majors) }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6

      - name: Setup Node
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: "20"
          registry-url: "https://registry.npmjs.org"

      - name: Publish the ${{ matrix.major }} spec package to npm
        env:
          MAJOR: ${{ matrix.major }}
          REPO_NAME: ${{ github.event.repository.name }}
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
        run: |
          set -euo pipefail
          spec="contracts/${MAJOR}/openapi.yaml"
          pkg="${REPO_NAME}-api-spec"
          # The npm version IS the spec's info.version (the version triangle).
          # yq ships on the GitHub-hosted ubuntu runner; js-yaml's CLI prints a
          # util.inspect dump, not JSON, so it can't be piped to jq.
          version="$(yq -r '.info.version' "$spec")"
          if [[ -z "$version" || "$version" == "null" ]]; then
            echo "::error::$spec has no info.version"
            exit 1
          fi
          # Enforce the version triangle at publish: info.version's major must
          # match the vN directory (#693 makes this a full pre-merge gate).
          if [[ "${version%%.*}" != "${MAJOR#v}" ]]; then
            echo "::error::$spec info.version ($version) disagrees with directory $MAJOR"
            exit 1
          fi
          # Idempotent: a routine app release with no contract change re-runs this
          # with an already-published version. Skip cleanly instead of failing.
          if npm view "${pkg}@${version}" version >/dev/null 2>&1; then
            echo "${pkg}@${version} already published — nothing to do."
            exit 0
          fi
          pkgdir="$(mktemp -d)"
          cp "$spec" "$pkgdir/openapi.yaml"
          jq -n --arg n "$pkg" --arg v "$version" --arg m "$MAJOR" \
            '{name: $n, version: $v,
              description: ("OpenAPI contract for " + $n + " (" + $m + ")"),
              files: ["openapi.yaml"], publishConfig: {access: "public"}}' \
            > "$pkgdir/package.json"
          # dist-tag "major-vN": a bare "vN" is a valid semver range, which npm
          # rejects as a dist-tag.
          echo "Publishing ${pkg}@${version} (dist-tag major-${MAJOR})"
          npm publish "$pkgdir" --tag "major-${MAJOR}"

      # Governance channel (#706) — the human-facing publication, fed from the
      # SAME contracts/${MAJOR}/openapi.yaml as the npm publish above and running
      # in the SAME job (no separate pipeline), so the machine + governance
      # channels can never drift. Presence-gated: both steps run only when an
      # apim/ config-as-code bundle exists; a repo without apim/ skips them with
      # no failure — npm alone is the full drift guarantee (#692).
      #
      # The portal-publish + proxy-deploy commands are the ONE org-specific seam.
      # The design's reference is an Apigee-style config-as-code bundle deployed
      # with apigeecli, shown commented below — REPLACE each placeholder `echo`
      # with your platform's CLI (Azure `az apim`, AWS API Gateway, Kong `deck`,
      # …). The plugin owns the wiring, the activation switch, the same-step
      # guarantee, and the secrets contract; the platform command is yours. Set
      # APIM_ENDPOINT + APIM_TOKEN repository secrets (surfaced in the Step 5
      # checklist). Until you replace them, the steps are inert placeholders and
      # say so in the log — nothing is actually published.
      - name: Publish ${{ matrix.major }} spec + docs to the APIM governance portal
        if: ${{ hashFiles('apim/**') != '' }}
        env:
          MAJOR: ${{ matrix.major }}
          APIM_ENDPOINT: ${{ secrets.APIM_ENDPOINT }}
          APIM_TOKEN: ${{ secrets.APIM_TOKEN }}
        run: |
          set -euo pipefail
          spec="contracts/${MAJOR}/openapi.yaml"
          # Publish the FULL spec (the portal's docs source) VERBATIM, so every
          # signal it carries — including deprecated: true + x-sunset (#695) —
          # reaches the portal for rendering. Reference (adapt to your platform):
          #   apigeecli apidocs create --title "orders ${MAJOR}" \
          #     --openapi "$spec" --token "$APIM_TOKEN"
          echo "[REFERENCE PLACEHOLDER — replace with your portal-publish CLI]"
          echo "Would publish $spec (spec + rendered docs) to the APIM portal (${APIM_ENDPOINT:-<unset>}) — ${MAJOR}"
      - name: Deploy the ${{ matrix.major }} API proxy from apim/
        if: ${{ hashFiles('apim/**') != '' }}
        env:
          MAJOR: ${{ matrix.major }}
          APIM_ENDPOINT: ${{ secrets.APIM_ENDPOINT }}
          APIM_TOKEN: ${{ secrets.APIM_TOKEN }}
        run: |
          set -euo pipefail
          # Deploy/update the config-as-code proxy bundle that lives in apim/ —
          # gateway config versioned in the repo next to the spec it exposes.
          # Reference (adapt to your platform):
          #   apigeecli apis create bundle --name orders --proxy-folder apim/ \
          #     --token "$APIM_TOKEN"
          echo "[REFERENCE PLACEHOLDER — replace with your proxy-deploy CLI]"
          echo "Would deploy apim/ proxy config-as-code to ${APIM_ENDPOINT:-<unset>} — ${MAJOR}"
