# Pre-commit hooks — run locally before each commit to enforce shift-left.
# Install with: pip install pre-commit && pre-commit install
# Run on all files: pre-commit run --all-files
#
# Language-specific blocks below are gated by the bootstrap skill — only the
# blocks matching {{LANGUAGES}} are kept; the rest are stripped.

repos:
  # --- universal hooks -------------------------------------------------------
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
        # mkdocs.yml uses MkDocs' custom YAML tags (e.g.
        # `!!python/name:pymdownx.superfences.fence_code_format` for Mermaid),
        # which check-yaml's safe loader can't construct. yamllint (below)
        # still lints it for style; excluding it here only skips tag
        # construction, not validation. (#777)
        exclude: ^mkdocs\.yml$
      - id: check-json
      - id: check-added-large-files
        args: ["--maxkb=1024"]
      - id: check-merge-conflict
      - id: detect-private-key

  # --- YAML lint -------------------------------------------------------------
  # Style + correctness for all YAML, using the repo's .yamllint config
  # (line-length 120, GitHub Actions `on:` allowed). Complements check-yaml,
  # which only validates syntax.
  - repo: https://github.com/adrienverge/yamllint
    rev: v1.38.0
    hooks:
      - id: yamllint
        # --strict: warnings fail the hook — zero-warnings policy (#781). The
        # .yamllint comments rule accepts Renovate's one-space pin style, so
        # strict mode stays green across dependency-bot updates.
        args: [--strict]

  # --- secret scanning -------------------------------------------------------
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks

  # --- static analysis (cross-language) --------------------------------------
  - repo: https://github.com/returntocorp/semgrep
    rev: v1.163.0
    hooks:
      - id: semgrep
        args: ["--config=auto", "--error", "--quiet"]

  # --- CLAUDE-PLUGIN-START ---------------------------------------------------
  # Plugin-repo lint: a Claude plugin repo is mostly shell scripts + markdown.
  # Lint those before commit (the YAML hook above covers workflows/configs; the
  # maintenance pipeline's script_quality validator additionally runs `zsh -n`
  # on .zsh, which shellcheck can't parse).
  - repo: https://github.com/koalaman/shellcheck-precommit
    rev: v0.10.0
    hooks:
      - id: shellcheck
  - repo: https://github.com/scop/pre-commit-shfmt
    rev: v3.10.0-1
    hooks:
      - id: shfmt
        args: ["-d"]
  - repo: https://github.com/igorshubovych/markdownlint-cli
    rev: v0.44.0
    hooks:
      - id: markdownlint
  # --- CLAUDE-PLUGIN-END -----------------------------------------------------

  # --- JAVASCRIPT-START ------------------------------------------------------
  - repo: https://github.com/pre-commit/mirrors-eslint
    rev: v10.4.0
    hooks:
      - id: eslint
        args: ["--max-warnings=0"]
        files: \.(js|jsx|ts|tsx)$
        additional_dependencies:
          - eslint@10.4.0
          - "@typescript-eslint/parser@8.59.4"
          - "@typescript-eslint/eslint-plugin@8.59.4"
  # Prettier runs from the project's OWN pinned version (npx --no-install) rather
  # than a separate pinned mirror, so pre-commit, CI, and local runs agree on one
  # version — the pin lives in the repo's package.json devDependencies.
  - repo: local
    hooks:
      - id: prettier
        name: prettier (write)
        entry: npx --no-install prettier --write
        language: system
        files: \.(js|jsx|ts|tsx|json|css|scss|md|ya?ml)$
  # --- JAVASCRIPT-END --------------------------------------------------------

  # --- PYTHON-START ----------------------------------------------------------
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.15.14
    hooks:
      - id: ruff
        args: ["--fix", "--exit-non-zero-on-fix"]
      - id: ruff-format

  # Coverage floor — local mirror of the CI `coverage-floor` step. Same
  # `diff-cover` invocation, same 90%-on-new-code threshold; catches the
  # bar locally before push instead of after CI rejects the PR.
  #
  # Stage is `pre-push`, not `pre-commit` — diff-cover reads coverage.xml
  # and compares against origin/{{DEFAULT_BRANCH}}, which only makes sense
  # at push time.
  #
  # Contract: assumes a recent `pytest --cov --cov-report=xml` produced
  # `coverage.xml` in the worktree. If it's missing, the hook fails with
  # a clear message — run pytest first.
  #
  # Worktree guard (#518): in a git worktree that reuses the main checkout's
  # venv, an editable install (`pip install -e`) resolves imports to the MAIN
  # checkout, so coverage.xml records that tree's paths and diff-cover counts
  # the worktree's changed lines as 0% covered — a false NOT-COVERED verdict.
  # A coverage figure computed against the wrong tree must be withheld, not
  # emitted: the entry first verifies the report's <source> lives inside THIS
  # worktree, and otherwise fails with the remedy (a per-worktree venv)
  # instead of a bogus number. A relative or absent <source> can't be proven
  # wrong, so it falls through to diff-cover's own handling.
  - repo: local
    hooks:
      - id: coverage-floor
        name: Coverage floor (90% on new code) — requires recent pytest --cov-report=xml
        entry: >-
          bash -c 'base=origin/{{DEFAULT_BRANCH}};
          if git rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1 &&
          [ -z "$(git diff --name-only --diff-filter=d "$base...HEAD" -- "*.py")" ];
          then exit 0; fi;
          top="$(git rev-parse --show-toplevel)";
          src="$(sed -n "s|.*<source>\(.*\)</source>.*|\1|p" coverage.xml 2>/dev/null | head -n 1)";
          case "$src" in
          ""|.|"$top"|"$top"/*) ;;
          /*) echo "coverage-floor: coverage.xml was recorded against $src — not this worktree ($top)." >&2;
          echo "Its numbers cannot judge this tree (stale or shared-venv editable install, #518). Create a venv" >&2;
          echo "in THIS worktree (python -m venv .venv && .venv/bin/pip install -e .), re-run" >&2;
          echo "pytest --cov --cov-report=xml, then push again." >&2;
          exit 1;;
          esac;
          exec diff-cover coverage.xml --compare-branch=origin/{{DEFAULT_BRANCH}} --fail-under=90'
        language: python
        additional_dependencies: ["diff-cover>=9"]
        pass_filenames: false
        # Run ONLY when this branch's diff vs origin/{{DEFAULT_BRANCH}} touches
        # Python — the guard at the top of `entry` no-ops (exit 0) when it
        # doesn't, so a docs/config/YAML-only push needs no coverage.xml (no test
        # build just to push a comment). We key on the origin/<default>...HEAD
        # diff, NOT pre-commit's `files:` filter: on a brand-new branch push git
        # reports the remote ref as all-zeros, so pre-commit diffs against the
        # empty tree and EVERY .py counts as "added" — `files: \.py$` then
        # over-fires and demands a vacuous report (#713). The entry guard uses
        # the same diff-base as CI + ensure-coverage-precondition.zsh, so local
        # and CI agree. `always_run` (not `files:`) so the guard always decides.
        always_run: true
        stages: [pre-push]
  # --- PYTHON-END ------------------------------------------------------------

  # --- GO-START --------------------------------------------------------------
  - repo: https://github.com/golangci/golangci-lint
    rev: v2.12.2
    hooks:
      - id: golangci-lint
  # --- GO-END ----------------------------------------------------------------

  # --- SWIFT-START -----------------------------------------------------------
  # SwiftLint + swift-format are invoked via local hooks because the official
  # mirrors are sparsely maintained. Install: brew install swiftlint swift-format.
  # Both read the bootstrap-rendered configs (.swiftlint.yml / .swift-format,
  # line-length 120 per the org-wide policy).
  - repo: local
    hooks:
      - id: swiftlint
        name: SwiftLint
        entry: swiftlint lint --strict --quiet
        language: system
        files: \.swift$
      - id: swift-format
        name: swift-format (lint)
        entry: swift-format lint --strict
        language: system
        files: \.swift$

  # Coverage floor — local mirror of the CI coverage-floor step. Same
  # diff-cover invocation on the lcov, same 90%-on-new-code threshold.
  # Stage is pre-push (compares against origin/{{DEFAULT_BRANCH}}). Contract:
  # assumes a recent test run exported coverage.lcov — the same recipe the
  # quality workflow's Swift job uses (SwiftPM: `swift test
  # --enable-code-coverage` + `xcrun llvm-cov export -format=lcov`; Xcode:
  # `xcodebuild test -enableCodeCoverage YES` + the DerivedData export).
  - repo: local
    hooks:
      - id: coverage-floor-swift
        name: Coverage floor (90% on new code) — requires recent swift test + llvm-cov lcov export
        entry: >-
          bash -c 'base=origin/{{DEFAULT_BRANCH}};
          if git rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1 &&
          [ -z "$(git diff --name-only --diff-filter=d "$base...HEAD" -- "*.swift")" ];
          then exit 0; fi;
          exec diff-cover coverage.lcov --compare-branch=origin/{{DEFAULT_BRANCH}} --fail-under=90'
        language: python
        additional_dependencies: ["diff-cover>=9"]
        pass_filenames: false
        # Run ONLY when this branch's diff vs origin/{{DEFAULT_BRANCH}} touches
        # Swift — the guard at the top of `entry` no-ops (exit 0) otherwise, so a
        # docs/config-only push needs no coverage.lcov. Keyed on the
        # origin/<default>...HEAD diff, not pre-commit's `files:` filter, which
        # over-fires on a brand-new branch push (empty-tree comparison counts
        # every .swift as "added", #713). `always_run` so the guard decides.
        always_run: true
        stages: [pre-push]
  # --- SWIFT-END -------------------------------------------------------------

  # --- JAVA-START ------------------------------------------------------------
  # Spotless (google-java-format) via the project's Gradle wrapper. Local hook
  # because Spotless is a Gradle plugin, not a standalone binary; `spotlessApply`
  # reformats Java (and Kotlin/Kotlin-DSL when the project's spotless config adds
  # a ktlint() step). Slower than ruff (Gradle daemon), so scoped to changed
  # sources. Requires the com.diffplug.spotless plugin in build.gradle(.kts) —
  # see the Java setup recommendation in SETUP.md / the bootstrap summary.
  # Line-length: this org targets 120 columns toolchain-wide, but Java is a
  # documented EXEMPTION — google-java-format is hardcoded to 100 columns and is
  # not configurable (see ARCHITECTURE.md "Line-length policy").
  - repo: local
    hooks:
      - id: spotless
        name: Spotless (google-java-format)
        entry: ./gradlew --no-daemon spotlessApply
        language: system
        files: \.(java|kt|kts)$
        pass_filenames: false

  # Coverage floor — local mirror of the CI `coverage-floor` step. Same
  # diff-cover invocation on the JaCoCo XML, same 90%-on-new-code threshold.
  # Stage is pre-push (compares against origin/{{DEFAULT_BRANCH}}). Contract:
  # assumes a recent `./gradlew test jacocoTestReport` produced the XML.
  - repo: local
    hooks:
      - id: coverage-floor-java
        name: Coverage floor (90% on new code) — requires recent gradlew test jacocoTestReport
        entry: >-
          bash -c 'base=origin/{{DEFAULT_BRANCH}};
          if git rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1 &&
          [ -z "$(git diff --name-only --diff-filter=d "$base...HEAD" -- "*.java" "*.kt")" ];
          then exit 0; fi;
          exec diff-cover build/reports/jacoco/test/jacocoTestReport.xml
          --compare-branch=origin/{{DEFAULT_BRANCH}} --fail-under=90'
        language: python
        additional_dependencies: ["diff-cover>=9"]
        pass_filenames: false
        # Run ONLY when this branch's diff vs origin/{{DEFAULT_BRANCH}} touches
        # Java/Kotlin SOURCE (`.java`/`.kt`, NOT `.kts` build scripts — a `*.kt`
        # pathspec ends at `.kt`, so `build.gradle.kts` never matches) — the
        # guard at the top of `entry` no-ops (exit 0) otherwise, avoiding a full
        # `./gradlew test jacocoTestReport` to push a comment. Keyed on the
        # origin/<default>...HEAD diff, not pre-commit's `files:` filter, which
        # over-fires on a brand-new branch push (empty-tree comparison counts
        # every source file as "added", #713). `always_run` so the guard decides.
        always_run: true
        stages: [pre-push]
  # --- JAVA-END --------------------------------------------------------------

  # --- PRIVATE-START ---------------------------------------------------------
  # Trivy filesystem scan — kept private-only because public repos run Snyk in
  # CI, and Snyk locally requires authentication. Trivy is unauthenticated and
  # fast enough to gate pre-commit on. Install: brew install trivy.
  - repo: local
    hooks:
      - id: trivy-fs
        name: Trivy filesystem scan
        entry: trivy fs --scanners vuln --severity HIGH,CRITICAL --exit-code 1 --quiet .
        language: system
        pass_filenames: false
        stages: [pre-commit]
  # --- PRIVATE-END -----------------------------------------------------------
