# WebUI Quality — the React app's browser and page-weight gates (#1946).
#
# Rendered only by the React overlay (bootstrap §3k.5), so a non-React JS repo
# never runs a job that installs Chromium. Its two jobs are REQUIRED status
# checks: branch-protection.sh adds `e2e (playwright)` and `lighthouse (budgets)`
# to the required contexts whenever this file is on disk. GitHub reports a job
# under its `name:`, which is why the names below are the contexts, not the ids.
#
# The axe accessibility gate is not here: it runs inside test-and-coverage
# (Vitest), where the a11y canary proves the matcher is wired.
#
# It skips the same doc-only paths as the quality workflow. A required check
# whose workflow was skipped would sit at `expected` forever, so
# webui-quality-noop.yml reports success under the same two names on exactly
# those paths.
name: WebUI Quality

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths-ignore:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths-ignore:
      - "**.md"
      - "LICENSE"
      - ".gitignore"
      - "docs/**"
  workflow_dispatch:

# Least privilege: both gates only read the checked-out tree.
permissions:
  contents: read

jobs:
  # Browser smoke: the production build's root route loads in a real Chromium.
  e2e:
    name: e2e (playwright)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      - name: Setup Node
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: "24"
          cache: "npm"
      - name: Install (npm ci)
        run: npm ci
      - name: Build (the smoke test serves dist/ with vite preview)
        run: npm run build
      - name: Install Chromium
        run: npx playwright install --with-deps chromium
      - name: Smoke test (Playwright)
        run: npx playwright test -c tests/e2e/playwright.config.ts
      - name: Upload the Playwright report
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: playwright-report
          path: tests/e2e/playwright-report/
          retention-days: 14

  # Page weight: Lighthouse CI measures the root route served by vite preview
  # and fails on the byte budgets in lighthouserc.json. LCP/TBT/CLS are collected
  # in the report but never asserted, so only the budgets can turn this red.
  lighthouse:
    name: lighthouse (budgets)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      - name: Setup Node
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: "24"
          cache: "npm"
      - name: Install (npm ci)
        run: npm ci
      - name: Build
        run: npm run build
      - name: Lighthouse budgets (lhci autorun)
        run: npx lhci autorun
      - name: Upload the Lighthouse reports
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: lighthouse-reports
          path: .lighthouseci/
          retention-days: 14
