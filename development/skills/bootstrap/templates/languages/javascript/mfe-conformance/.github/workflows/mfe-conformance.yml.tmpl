# MFE Conformance — prove this remote conforms to mfe-contract/v1 (epic #1122;
# issue #1126).
#
# The contract is types-only, so the compiler checks a remote against the
# contract but nothing checks it against the shell. This job builds the remote
# with `npm run build:remote` and runs scripts/check-mfe-conformance.zsh on
# dist/remote.js: the declared @*/mfe-contract major against the shell's, the
# mount/unmount exports and their arity, and — for a widget — the manifest's
# contractMajor.
#
# The shell's major is the MFE_SHELL_MAJOR repository variable, defaulting to 1,
# the contract's only major today. A widget's "shell" is the canvas host.
#
# When the repo has a root Dockerfile, the job also builds and starts the
# container and checks that it serves the same entry at /remote.js. Without one,
# only the static checks run.
#
# Path-conditional and never a required context. Rendered only into a remote
# repo (bootstrap §3k.10). Generated by /development:bootstrap. Source template:
# development/skills/bootstrap/templates/languages/javascript/mfe-conformance/.github/workflows/mfe-conformance.yml.tmpl
name: mfe-conformance

on:
  pull_request:
    branches: ["{{DEFAULT_BRANCH}}"]
    paths:
      - "src/remote/**"
      - "vite.remote.config.ts"
      - "package.json"
      - "package-lock.json"
      - "Dockerfile"
      - "scripts/check-mfe-conformance.zsh"
      - ".github/workflows/mfe-conformance.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: mfe-conformance-${{ github.ref }}
  cancel-in-progress: true

jobs:
  mfe-conformance:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      MFE_SHELL_MAJOR: ${{ vars.MFE_SHELL_MAJOR || '1' }}
      # The static-asset container (#1062) serves the remote's dist/ at its root.
      # Override the port if your container listens elsewhere; the steps build
      # the base URL from it.
      MFE_PORT: "8080"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Setup Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: ".nvmrc"
          cache: "npm"

      - name: Install checker toolchain (zsh; jq and curl ship on the runner)
        run: |
          set -euo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y --no-install-recommends zsh >/dev/null

      - name: Install dependencies
        run: npm ci

      - name: Build the remote
        run: npm run build:remote

      - name: Check the built entry
        run: >-
          zsh scripts/check-mfe-conformance.zsh --entry dist/remote.js --package package.json
          --shell-major "${MFE_SHELL_MAJOR}"

      - name: Build the container
        if: hashFiles('Dockerfile') != ''
        run: docker build -t mfe-conformance-remote .

      - name: Start the container
        if: hashFiles('Dockerfile') != ''
        run: |
          set -euo pipefail
          docker run -d --name mfe-remote -p "${MFE_PORT}:${MFE_PORT}" mfe-conformance-remote
          for i in $(seq 1 30); do
            if curl -fsS -m 2 -o /dev/null "http://localhost:${MFE_PORT}/remote.js"; then
              echo "container serves /remote.js after ${i} attempt(s)"; exit 0
            fi
            sleep 2
          done
          echo "::error::the container did not serve http://localhost:${MFE_PORT}/remote.js"
          docker logs mfe-remote || true
          exit 1

      - name: Check the served entry
        if: hashFiles('Dockerfile') != ''
        run: >-
          zsh scripts/check-mfe-conformance.zsh --entry dist/remote.js --package package.json
          --shell-major "${MFE_SHELL_MAJOR}" --base-url "http://localhost:${MFE_PORT}"

      - name: Tear down
        if: always() && hashFiles('Dockerfile') != ''
        run: docker rm -f mfe-remote || true
