#!/usr/bin/env zsh
# go-gate.zsh — this Go repository's gate MECHANISM (#2122), owned and re-rendered by
# /development:bootstrap. `make check` runs it; CI's single `gate` job and hooks/pre-push run
# `make check`, so the gate is one command everywhere (platform contract §12).
#
# Stages, cheapest first, and the first failure stops the gate:
#   1 format             golangci-lint fmt --diff — fails on any diff, never rewrites a file
#   2 lint               golangci-lint run with the repo's .golangci.yml (go vet runs inside it)
#   3 proto              only with buf.yaml: buf lint, then buf breaking against the base branch
#   4 generation         only with buf.gen.yaml: buf generate, then no drift in the generated paths
#   5 tests              go test -race with coverage, then the 90% floor on changed Go lines
#   6 vulns              govulncheck, plus trivy fs (vuln, secret, misconfig) when .maintenance.yml
#                        declares trivy
#   7 secrets            gitleaks over the commits on base..HEAD
#   8 no cluster deploy  scripts/check-no-cluster-deploy.zsh over .github/workflows/**
#   9 license            trivy fs --scanners license, whatever tools.vulnerabilities declares
#  10 pre-commit         every pre-commit hook over every file, but the two stages 6-7 already run
#  11 contracts lint     only when contracts/ or .spectral.yaml changed: Spectral over the newest major
#  12 contracts semver   only when contracts/ or its checker changed: the version triangle and bump
#  13 docs               only when the docs sources changed: mkdocs build --strict, then the manuals
#
# A stage whose input is absent, or whose tool .maintenance.yml declares `none` (#2121), prints
# one `go-gate: skip <stage> — <reason>` line. The gate never skips a stage silently.
#
# The base ref is origin/{{DEFAULT_BRANCH}} as rendered, never a hard-coded branch. golangci-lint,
# diff-cover, trivy, gitleaks and pre-commit come from `make setup` (.tools/bin), and a missing one
# fails the gate naming `make setup`. buf, govulncheck, gocover-cobertura, oasdiff and yq run through
# `go tool`, pinned by go.mod's tool directives: a missing one fails its stage under go's own "no
# such tool" error, and `go get -tool` adds it. oasdiff and yq reach the checker scripts that call
# them by name through shims on PATH. Spectral and the pandoc image are pinned below. node, python3,
# docker and jq are the machine's own; a missing one fails its stage naming the tool.
#
# Usage: zsh scripts/go-gate.zsh [-h|--help], from the repository root. It gates the current
# directory and takes no other argument.
#
# Exit codes: 0 every stage passed or was skipped with a notice; 1 a stage failed, or a tool it
# needs is missing; 2 an unknown argument.

emulate -L zsh
setopt pipefail no_unset

if (( $# )); then
	case "$1" in
	-h | --help)
		awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
		exit 0
		;;
	*)
		print -u2 -r -- "go-gate: unknown argument: $1"
		exit 2
		;;
	esac
fi

# the versions of the two tools the gate runs without installing them first
spectral_cli="@stoplight/spectral-cli@6.15.0"
pandoc_image="pandoc/extra:3.5"

base="origin/{{DEFAULT_BRANCH}}"
path=("$PWD/.tools/bin" $path)

stage() { print -r -- "go-gate: $1" }
skip() { print -r -- "go-gate: skip $1 — $2" }
fail() { print -u2 -r -- "go-gate: FAIL $1"; exit 1 }
need() { command -v "$1" >/dev/null 2>&1 || fail "$2 — $1 is not installed; run make setup" }
# a tool the machine provides, which make setup does not install
require() { command -v "$1" >/dev/null 2>&1 || fail "$2 — $1 is not installed" }
# a go.mod tool a checker script runs through its shim, which hides go's "no such tool" error
go_tool() { go tool -n "$1" >/dev/null || fail "$2 — go tool $1 is missing; go get -tool adds it" }
# true when a path under one of the given pathspecs changed against the base
changed() { [[ -n "$(git diff --name-only "$base...HEAD" -- "$@")" ]] }

# tools.<category> from .maintenance.yml's block mapping; empty when absent
declared() {
	[[ -f .maintenance.yml ]] || return 0
	awk -v k="$1:" '/^tools:/ { t = 1; next } t && /^[^[:space:]#]/ { t = 0 }
		t && $1 == k { print $2; exit }' .maintenance.yml
}

# a top-level scalar of mkdocs.yml, without a trailing comment or surrounding quotes
mkdocs_key() {
	awk -v k="$1:" '$1 == k { v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/[[:space:]]+#.*$/, "", v)
		gsub(/^["\047]|["\047]?[[:space:]]*$/, "", v); print v; exit }' mkdocs.yml
}

# --- selector-start (tests/render-contracts-templates.bats runs it beside contracts-lint.yml's)
# newest_major <family> <file>: the newest strict vN directory of <family> holding <file>, as
# <family>/vN/<file>; with an empty <file>, the newest vN directory itself. A v3-draft or v2.bak
# is not a major, and majors compare as integers, so v10 is newer than v9.
newest_major() {
	local c n best="" best_n=-1
	for c in "$1"/v[0-9]*/"$2"(N); do
		n="${c#"$1"/v}"
		n="${n%%/*}"
		[[ "$n" == <-> ]] || continue
		if (( n > best_n )); then
			best_n=$n
			best="$c"
		fi
	done
	print -rn -- "$best"
}
# contract_specs: the newest major's openapi.yaml of contracts/ and of contracts/ops/, one a line.
# A newest vN directory without an openapi.yaml fails, rather than falling back to an older,
# frozen major that nobody may change.
contract_specs() {
	local family spec dir
	for family in contracts contracts/ops; do
		spec="$(newest_major "$family" openapi.yaml)"
		dir="$(newest_major "$family" "")"
		if [[ -n "$dir" && "$spec" != "${dir}openapi.yaml" ]]; then
			print -u2 -r -- "go-gate: ${dir} is the newest major of ${family} but has no openapi.yaml —" \
				"refusing to fall back to an older, frozen major. Commit the spec, or remove the directory."
			return 1
		fi
		[[ -z "$spec" ]] || print -r -- "$spec"
	done
}
# --- selector-end

# scratch for the shims and the manuals, removed however the gate ends
scratch="$(mktemp -d)" || fail "mktemp"
trap 'rm -rf "$scratch"' EXIT
# oasdiff and yq are pinned in go.mod; the checker scripts call them by name
mkdir -p "$scratch/bin"
for t in oasdiff yq; do
	printf '#!/bin/sh\nexec go tool %s "$@"\n' "$t" > "$scratch/bin/$t"
	chmod +x "$scratch/bin/$t"
done
path=("$scratch/bin" $path)

git rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1 ||
	fail "base branch — $base is not a commit here; run git fetch origin"

# a go.mod with no package yet (a fresh repository) gives format, lint, tests and govulncheck
# no Go code to check; everything else still runs
pkgs="$(go list ./...)" || fail "go list ./..."
if [[ -z "$pkgs" ]]; then
	for s in format lint; do skip "$s" "no Go package yet"; done
else
	# --- 1 format -----------------------------------------------------------------------
	stage "format"
	need golangci-lint format
	fmt_out="$(golangci-lint fmt --diff 2>&1)" || { print -u2 -r -- "$fmt_out"; fail "format — run make fmt"; }
	[[ -z "$fmt_out" ]] || { print -u2 -r -- "$fmt_out"; fail "format — run make fmt"; }

	# --- 2 lint -------------------------------------------------------------------------
	stage "lint"
	golangci-lint run || fail "lint"
fi

# --- 3 proto ------------------------------------------------------------------------
if [[ -f buf.yaml ]]; then
	stage "proto"
	go tool buf lint || fail "proto — buf lint"
	if git cat-file -e "$base:buf.yaml" 2>/dev/null; then
		go tool buf breaking --against ".git#branch=$base" || fail "proto — buf breaking against $base"
	else
		skip "proto breaking check" "$base has no buf.yaml yet (the first proto module)"
	fi
else
	skip "proto" "no buf.yaml"
fi

# --- 4 generation drift -------------------------------------------------------------
if [[ -f buf.gen.yaml ]]; then
	stage "generation"
	# the generated paths: every `out:` in buf.gen.yaml
	# (the value after the key, without a trailing comment or surrounding quotes)
	gen_paths=(${(f)"$(awk '$1 == "out:" || $1 == "-" && $2 == "out:" {
		v = $0; sub(/[[:space:]]+#.*$/, "", v); sub(/^[^:]*:[[:space:]]*/, "", v)
		gsub(/^["\047]|["\047]?[[:space:]]*$/, "", v); print v }' buf.gen.yaml)"})
	(( ${#gen_paths} )) || fail "generation — buf.gen.yaml names no out: path"
	# drift is what buf generate changed, so an unrelated file under an `out: .` path is not drift
	before="$(git status --porcelain --untracked-files=all -- "${gen_paths[@]}")"
	go tool buf generate || fail "generation — buf generate"
	after="$(git status --porcelain --untracked-files=all -- "${gen_paths[@]}")"
	[[ "$after" == "$before" ]] || {
		print -u2 -r -- "$after"
		fail "generation — committed generated code does not match the protos; run make generate and commit"
	}
else
	skip "generation" "no buf.gen.yaml"
fi

if [[ -z "$pkgs" ]]; then
	skip "tests" "no Go package yet"
else
	# --- 5 tests and the coverage floor ------------------------------------------------
	stage "tests"
	go test -race -coverprofile=coverage.out -covermode=atomic ./... || fail "tests"
	go tool gocover-cobertura -ignore-gen-files < coverage.out > coverage.xml || fail "tests — cobertura export"
	if [[ -z "$(git diff --name-only --diff-filter=d "$base...HEAD" -- '*.go')" ]]; then
		skip "coverage floor" "no Go file changed against $base"
	else
		need diff-cover "coverage floor"
		diff-cover coverage.xml --compare-branch="$base" --fail-under=90 ||
			fail "coverage floor — changed Go lines are below 90% covered against $base"
	fi
fi

# --- 6 vulnerabilities --------------------------------------------------------------
vulns="$(declared vulnerabilities)"
if [[ "$vulns" == none ]]; then
	skip "vulnerabilities" "tools.vulnerabilities is none"
else
	stage "vulnerabilities"
	if [[ -z "$pkgs" ]]; then
		skip "govulncheck" "no Go package yet"
	else
		go tool govulncheck ./... || fail "vulnerabilities — govulncheck"
	fi
	if [[ "$vulns" == trivy ]]; then
		need trivy "vulnerabilities"
		trivy fs --config trivy.yaml --scanners vuln,secret,misconfig . || fail "vulnerabilities — trivy fs"
	fi
fi

# --- 7 secrets ----------------------------------------------------------------------
# every commit this branch adds, whatever tools.vulnerabilities declares
stage "secrets"
need gitleaks "secrets"
gitleaks git --no-banner --redact --log-opts="$base..HEAD" . ||
	fail "secrets — gitleaks found a secret in a commit on $base..HEAD"

# --- 8 no cluster deploy ------------------------------------------------------------
# unconditional: the scan is static and cheap, and an application repo never deploys to a cluster
stage "no cluster deploy"
[[ -f scripts/check-no-cluster-deploy.zsh ]] ||
	fail "no cluster deploy — scripts/check-no-cluster-deploy.zsh is missing; re-run /development:bootstrap"
require jq "no cluster deploy"
go_tool yq "no cluster deploy"
zsh scripts/check-no-cluster-deploy.zsh || fail "no cluster deploy — see the checker's message above"

# --- 9 license ----------------------------------------------------------------------
# whatever tools.vulnerabilities declares: a dependency's license is not a vulnerability
stage "license"
need trivy "license"
trivy fs --config trivy.yaml --scanners license . || fail "license — trivy fs --scanners license"

# --- 10 pre-commit ------------------------------------------------------------------
# the gitleaks and trivy-fs hooks are skipped: stages 6, 7 and 9 already run those scans
if [[ -f .pre-commit-config.yaml ]]; then
	stage "pre-commit"
	need pre-commit "pre-commit"
	SKIP=gitleaks,trivy-fs pre-commit run --all-files || fail "pre-commit"
else
	skip "pre-commit" "no .pre-commit-config.yaml"
fi

# --- 11 contracts lint --------------------------------------------------------------
if changed contracts .spectral.yaml; then
	stage "contracts lint"
	require node "contracts lint"
	spec_list="$(contract_specs)" || fail "contracts lint — the newest contract major has no openapi.yaml"
	specs=(${(f)spec_list})
	if (( ${#specs} )); then
		print -r -- "go-gate: linting ${specs[*]}"
		npx --yes "$spectral_cli" lint --ruleset .spectral.yaml --fail-severity error "${specs[@]}" ||
			fail "contracts lint — spectral"
	else
		skip "contracts lint" "no contracts/vN/openapi.yaml"
	fi
else
	skip "contracts lint" "no change under contracts/ or to .spectral.yaml against $base"
fi

# --- 12 contracts semver ------------------------------------------------------------
# Both families run, and both findings files are written even when one fails: a run whose HEAD
# has no contracts/ops/ still checks the base, which is what rejects retiring a live ops major.
if changed contracts .github/scripts/check-contracts-semver.sh; then
	stage "contracts semver"
	[[ -f .github/scripts/check-contracts-semver.sh ]] ||
		fail "contracts semver — .github/scripts/check-contracts-semver.sh is missing; re-run /development:bootstrap"
	require jq "contracts semver"
	go_tool oasdiff "contracts semver"
	# a findings file left by an earlier run must not stand in for one this run did not write
	rm -f contracts-semver-findings.json contracts-ops-semver-findings.json
	semver_rc=0
	bash .github/scripts/check-contracts-semver.sh --base-ref "$base" \
		--output contracts-semver-findings.json || semver_rc=1
	bash .github/scripts/check-contracts-semver.sh --base-ref "$base" --contracts-dir contracts/ops \
		--output contracts-ops-semver-findings.json || semver_rc=1
	(( semver_rc == 0 )) ||
		fail "contracts semver — see the checker's messages above, and the findings files it wrote"
else
	skip "contracts semver" "no change under contracts/ or to its checker against $base"
fi

# --- 13 docs ------------------------------------------------------------------------
docs_paths=(docs mkdocs.yml requirements-docs.txt scripts/docs-nav-to-chapters.zsh scripts/pandoc)
if ! changed "${docs_paths[@]}"; then
	skip "docs" "no change to the docs sources against $base"
elif [[ ! -f mkdocs.yml ]]; then
	skip "docs" "no mkdocs.yml"
else
	stage "docs"
	require python3 "docs"
	require docker "docs"
	python3 -m venv .tools/docs-venv &&
		.tools/docs-venv/bin/pip install --quiet -r requirements-docs.txt ||
		fail "docs — installing requirements-docs.txt"
	.tools/docs-venv/bin/mkdocs build --strict --site-dir "$scratch/site" ||
		fail "docs — mkdocs build --strict"
	chapter_list="$(zsh scripts/docs-nav-to-chapters.zsh)" || fail "docs — deriving the chapter order"
	chapters=(${(f)chapter_list})
	# the manuals' title and author: the site's name and repository, which bootstrap renders into
	# mkdocs.yml from the same values it renders into docs.yml
	title="$(mkdocs_key site_name)"
	author="$(mkdocs_key repo_name)"
	# the manuals' page setup and layout fixes are docs.yml's, carried over unchanged
	docker run --rm -v "$PWD:/data" -v "$scratch:/out" -w /data "$pandoc_image" \
		--pdf-engine=xelatex --toc -V fontsize=11pt \
		--metadata title="$title" --metadata author="$author" \
		--lua-filter=scripts/pandoc/break-long-tokens.lua \
		--include-in-header=scripts/pandoc/manual-header.tex \
		-o /out/manual.pdf "${chapters[@]}" > "$scratch/pandoc-pdf.log" 2>&1 || {
		cat "$scratch/pandoc-pdf.log" >&2
		fail "docs — pandoc manual.pdf"
	}
	docker run --rm -v "$PWD:/data" -v "$scratch:/out" -w /data "$pandoc_image" \
		--toc --metadata title="$title" --metadata author="$author" \
		-o /out/manual.epub "${chapters[@]}" || fail "docs — pandoc manual.epub"
	[[ -s "$scratch/manual.pdf" && -s "$scratch/manual.epub" ]] || fail "docs — a manual was not produced"
	# xelatex drops a character it has no glyph for silently
	if grep "Missing character" "$scratch/pandoc-pdf.log" >&2; then
		fail "docs — xelatex dropped the characters above from manual.pdf; add a \\DeclareUnicodeFallback for each to scripts/pandoc/manual-header.tex"
	fi
	# The unresolved-reference check is a negative test, so a probe whose only link dangles must
	# show the warning first: a pandoc image that stops reporting it would leave the check blind.
	probe_log="$(docker run --rm --entrypoint sh "$pandoc_image" -c \
		'printf "# Probe\n\nA [dangling](#no-such-anchor) link.\n" > /tmp/probe.md
		pandoc --pdf-engine=xelatex -o /tmp/probe.pdf /tmp/probe.md' 2>&1)" || {
		print -u2 -r -- "$probe_log"
		fail "docs — the pandoc probe container failed; that is infrastructure, not a pandoc change"
	}
	if [[ "$probe_log" != *"There were undefined references"* ]]; then
		print -u2 -r -- "$probe_log"
		fail "docs — pandoc no longer reports undefined references, so the reference check cannot fail"
	fi
	if grep -q "There were undefined references" "$scratch/pandoc-pdf.log"; then
		grep -B2 -A2 "undefined" "$scratch/pandoc-pdf.log" >&2
		fail "docs — manual.pdf has unresolved references; they work on the site only. Give the target heading the {#id} it already publishes, or fix the link"
	fi
fi

stage "passed"
