#!/usr/bin/env zsh
# over-budget.zsh — turn a rendered React app into the over-budget fixture (#1946).
#
# Usage: over-budget.zsh <app-dir>
#
# The `lighthouse (budgets)` gate must be proven to FAIL on a heavy build, but a
# template that shipped the weight would turn every bootstrapped app's blocking
# gate red from day one. So the weight lives here, in this repo, never in a
# render list: this script writes it into an app that bootstrap already rendered.
#
# It adds src/ballast.ts — ~600 KiB of random bytes, base64-encoded — and makes
# src/main.tsx use it, so the bundler cannot drop it. Random data is used because
# Lighthouse measures TRANSFER size: a repetitive blob would compress below the
# 300 KiB script budget and prove nothing. The bytes are generated at run time
# rather than committed, which keeps a high-entropy blob out of the repository.
#
# Then `npm run build && npx lhci autorun` in <app-dir> must exit non-zero, with
# `resource-summary:script:size` (and `resource-summary:total:size`) failing.
# Running it is #1063's React tier; this repo only keeps the fixture.
set -euo pipefail

app="${1:-}"
if [[ -z "$app" || ! -f "$app/src/main.tsx" ]]; then
	print -u2 "usage: over-budget.zsh <app-dir>  (the app must have src/main.tsx)"
	exit 2
fi

ballast="$app/src/ballast.ts"
{
	print '// Generated by tests/fixtures/react-webui/over-budget.zsh — deliberately over budget.'
	print -n 'export const BALLAST = "'
	head -c 614400 /dev/urandom | base64 | tr -d '\n'
	print '";'
} > "$ballast"

if ! grep -q 'from "./ballast"' "$app/src/main.tsx"; then
	{
		print 'import { BALLAST } from "./ballast";'
		print 'document.documentElement.dataset.ballast = String(BALLAST.length);'
	} >> "$app/src/main.tsx"
fi

print "over-budget: wrote $(wc -c < "$ballast" | tr -d ' ') bytes to $ballast"
