flowchart TD
    classDef human fill:#fde7c8,stroke:#b8741a,color:#222
    classDef conductor fill:#dbe8fb,stroke:#3567b5,color:#222
    classDef agent fill:#e9ddf7,stroke:#7a4cb5,color:#222
    classDef bot fill:#d9f2df,stroke:#2e8b4e,color:#222
    classDef artifact fill:#eeeeee,stroke:#777,color:#222

    subgraph SETUP["1 · Set up"]
        BOOT["/development:bootstrap<br/>once: toolchain, CI, hooks, docs"]:::conductor
        PERS["/development:define-personas<br/>docs/personas.md"]:::conductor
    end

    subgraph SPEC["2 · Specify"]
        ISSUE["Issue or epic filed"]:::human
        GATE{"resolve-issue steps 0-0b:<br/>unblocked,<br/>READY?"}
        CREF["chain step: chained refinement<br/>refine the story or split it,<br/>then resume"]:::conductor
        BFIRST["chain step: blockers first<br/>each open blocker resolved<br/>and merged, deepest-first"]:::conductor
        REF["/development:refine-issue<br/>you drive it: questions,<br/>rewrite, story spec"]:::conductor
    end

    subgraph BUILD["3 · Build"]
        IMPL["resolve-issue steps 1-3:<br/>branch, implement, test gate"]:::conductor
        LOOP["Review loop<br/>panel, fix, re-test"]:::agent
    end

    subgraph SHIP["4 · Ship"]
        PR["PR by the Maintenance App,<br/>auto-merge armed"]:::bot
        APPR["Approval: Approver bot<br/>or a human"]:::bot
        MERGE[("Merged on green CI")]:::artifact
        CHAIN["chain step: follow-up chain<br/>each filed follow-up<br/>refined, then built"]:::conductor
    end

    subgraph OPS["5 · Maintain"]
        FIND[("Scanner findings, dependency<br/>PRs, coverage")]:::artifact
        MAINT["/development:maintenance<br/>one PR per finding group"]:::conductor
    end

    BOOT -- "toolchain in place" --> ISSUE
    ISSUE -- "you start<br/>resolve-issue" --> GATE
    GATE -- "not READY,<br/>human-started" --> CREF
    CREF -- ready --> IMPL
    CREF -- "split: each child<br/>through this flow" --> GATE
    GATE -- "blocked,<br/>human-started" --> BFIRST
    BFIRST -- "all merged:<br/>re-check" --> GATE
    GATE -- "not READY,<br/>pipeline-started" --> REF
    REF -- "ready: run<br/>resolve-issue again" --> GATE
    PERS -. "personas, test data" .-> REF
    GATE -- yes --> IMPL --> LOOP
    IMPL -- "oversized,<br/>human-started" --> CREF
    LOOP -- converged --> PR
    PR --> APPR --> MERGE
    MERGE -- "human-started" --> CHAIN
    CHAIN -- "next follow-up,<br/>refined first" --> IMPL
    MERGE --> FIND
    FIND --> MAINT --> PR
    MAINT -. "work for a human:<br/>new issues" .-> ISSUE
