flowchart TD
    classDef human fill:#fde7c8,stroke:#b8741a,color:#222
    classDef conductor fill:#dbe8fb,stroke:#3567b5,color:#222
    classDef agent fill:#e9ddf7,stroke:#7a4cb5,color:#222
    classDef stop fill:#f8d7d7,stroke:#b33,color:#222
    classDef ok fill:#d9f2df,stroke:#2e8b4e,color:#222

    START(["/development:refine-issue N"]):::human
    EPIC(["/development:refine-issue E<br/>on an epic"]):::human
    WALK["Epic walk, phase A: each<br/>needs-refinement child drafted<br/>through this flow in turn"]:::conductor
    CHAIN(["Chained entry from resolve-issue:<br/>--chained-from root --handoff file"]):::conductor
    DIAG["Steps 0-1: fetch, resume a park,<br/>diagnose with story-readiness"]:::agent
    TURN["Step 2: refiner turn<br/>explanations, typed and scored<br/>questions, draft prose + story spec"]:::agent
    CONV{"Objections resolved,<br/>no questions left?"}
    KIND{"Each question:<br/>its kind and confidence"}
    DEC["Implementation question:<br/>decided and recorded in<br/>Decisions taken, never asked"]:::conductor
    AUTO["Intent or gap question at or<br/>above the threshold: answered,<br/>one line shown to you"]:::conductor
    ASK["Intent or gap question below<br/>the threshold, a gap with its doc<br/>change: you answer"]:::human
    PEND(["Chained: questions pending,<br/>resolve-issue asks you and<br/>dispatches it again"]):::conductor
    PARK(["Typed parked exit"]):::stop
    NEXT(["Converged draft<br/>(next diagram)"]):::ok

    START --> DIAG
    EPIC --> WALK --> DIAG
    CHAIN -- "first dispatch" --> DIAG
    DIAG --> TURN --> CONV
    CONV -- "no: questions" --> KIND
    KIND -- implementation --> DEC --> TURN
    KIND -- "intent or gap,<br/>confident" --> AUTO --> TURN
    KIND -- "intent or gap,<br/>below threshold" --> ASK --> TURN
    ASK -- "can't converge yet" --> PARK
    KIND -- "below threshold,<br/>chained" --> PEND
    PEND -- "your answers" --> TURN
    CONV -- yes --> NEXT
