flowchart TD
    classDef human fill:#fde7c8,stroke:#b8741a,color:#222
    classDef conductor fill:#dbe8fb,stroke:#3567b5,color:#222
    classDef agent fill:#e9ddf7,stroke:#7a4cb5,color:#222
    classDef bot fill:#d9f2df,stroke:#2e8b4e,color:#222
    classDef artifact fill:#eeeeee,stroke:#777,color:#222
    classDef stop fill:#f8d7d7,stroke:#b33,color:#222

    START(["/development:resolve-issue N"]):::human
    EPIC(["Epic: each child through<br/>this flow, then a holistic test"]):::conductor
    GATES{"Steps 0-0b:<br/>unblocked,<br/>READY?"}
    STOP(["Stop: blocked or needs-refinement<br/>(pipeline-started run)"]):::stop
    BFIRST["chain step: blockers first<br/>each open blocker resolved<br/>and merged, deepest-first,<br/>without asking"]:::conductor
    BSTOP(["Stop: blockers first stopped:<br/>a cycle, a foreign blocker<br/>or one that cannot finish"]):::stop
    REFINE["chain step: chained refinement<br/>refine the story or split it,<br/>then resume"]:::conductor
    RSTOP(["Stop: chained refinement stopped:<br/>the park's label kept"]):::stop
    BUILD(["Steps 1-6: build, review<br/>and ship (next diagram)"]):::conductor

    START -- epic --> EPIC
    START -- issue --> GATES
    GATES -- "no, pipeline-started" --> STOP
    GATES -- "blocked,<br/>human-started" --> BFIRST
    BFIRST -- "all merged:<br/>re-check" --> GATES
    BFIRST -- "cannot clear" --> BSTOP
    GATES -- "not READY,<br/>human-started" --> REFINE
    REFINE -- split --> EPIC
    REFINE -- ready --> BUILD
    REFINE -- stopped --> RSTOP
    GATES -- yes --> BUILD
